---
// Sticky bottom bar – pojawia się po scrollu, znika gdy user dotrze do #zapis. Dwujęzyczny (prop `lang`).
// PL promuje kurs „Menu z głowy” (świeżo po premierze), EN zostaje przy newsletterze,
// bo kurs jest po polsku. Bez kwoty: cena premierowa będzie podnoszona.
import type { Lang } from '../i18n/ui';
import { KURS_URL } from '../consts';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    mainA: 'Kurs „Menu z głowy” · ',
    mainB: 'cena premierowa',
    sub: 'Planer posiłków, który ustawiasz raz. 10 lekcji wideo i 3 bonusowe.',
    cta: 'Zobacz kurs',
    href: KURS_URL,
    zewnetrzny: true,
    close: 'Zamknij',
  },
  en: {
    mainA: 'One letter about AI every other Thursday · ',
    mainB: 'straight to your inbox',
    sub: 'No spam. Unsubscribe in one click. Written in Polish.',
    cta: 'Sign up',
    href: '/en/newsletter',
    zewnetrzny: false,
    close: 'Close',
  },
}[lang];
---

<div
  id="sticky-bar"
  class="fixed bottom-0 inset-x-0 z-50 transform translate-y-full transition-transform duration-300 ease-out pointer-events-none"
>
  <div class="bg-charcoal text-white border-t-4 border-terra shadow-2xl">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-4 flex flex-col sm:flex-row items-center gap-4 pointer-events-auto">
      <!-- Tekst -->
      <div class="flex-1 min-w-0">
        <p class="text-sm md:text-base font-semibold">
          {content.mainA}<span class="text-terra-light">{content.mainB}</span>
        </p>
        <p class="text-xs text-white/60 hidden sm:block">
          {content.sub}
        </p>
      </div>

      <!-- CTA → landing kursu (PL) albo zapis na newsletter (EN) -->
      <a
        href={content.href}
        target={content.zewnetrzny ? '_blank' : undefined}
        rel={content.zewnetrzny ? 'noopener' : undefined}
        class="px-6 py-2.5 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-lg transition-colors text-sm whitespace-nowrap w-full sm:w-auto text-center"
      >
        {content.cta}
      </a>

      <!-- Close button -->
      <button
        id="sticky-close"
        class="text-white/60 hover:text-white transition-colors pointer-events-auto"
        aria-label={content.close}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-bar');
  const closeBtn = document.getElementById('sticky-close');
  const zapisSection = document.getElementById('zapis');
  let dismissed = sessionStorage.getItem('sticky-dismissed') === 'true';
  let shown = false;

  function showBar() {
    if (!dismissed && !shown && bar) {
      bar.classList.remove('translate-y-full');
      bar.classList.add('translate-y-0', 'pointer-events-auto');
      shown = true;
    }
  }

  function hideBar() {
    if (bar) {
      bar.classList.add('translate-y-full');
      bar.classList.remove('translate-y-0', 'pointer-events-auto');
    }
  }

  window.addEventListener('scroll', () => {
    if (window.scrollY > 700) {
      showBar();
    }
  });

  if (zapisSection) {
    const zapisObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            hideBar();
          } else if (shown && !dismissed) {
            if (window.scrollY > 700) {
              bar?.classList.remove('translate-y-full');
              bar?.classList.add('translate-y-0', 'pointer-events-auto');
            }
          }
        });
      },
      { threshold: 0.1 }
    );
    zapisObserver.observe(zapisSection);
  }

  closeBtn?.addEventListener('click', () => {
    dismissed = true;
    sessionStorage.setItem('sticky-dismissed', 'true');
    hideBar();
  });
</script>
