---
// LeadMagnet – sekcja newslettera „AI na macierzyńskim" (#mapa). Newsletter darmowy, co tydzień.
// Zapis = Mapa 5 obszarów AI w prezencie; wzięcie Mapy = zapis do newslettera (to jedno i to samo).
// CTA prowadzi na dedykowany landing zapisu /mapa (formularz MailerLite).
const dostajesz = [
  { label: 'Na start:', text: 'Mapa 5 obszarów AI – pięć konkretów i pięć gotowych promptów, sześć minut czytania.' },
  { label: 'Co tydzień:', text: 'jeden krótki mail – jedna lekcja, jeden prompt do wklejenia, jeden news z AI.' },
  { label: 'Zawsze:', text: 'konkret pod pracę mamy wracającej do gry. Bez żargonu, bez spamu.' },
];
---

<section id="mapa" class="relative px-6 py-24 bg-cream overflow-hidden">
  <!-- Dekoracja -->
  <div class="blob bg-terra-soft" style="width: 450px; height: 450px; top: -100px; right: -150px; opacity: 0.35;"></div>
  <div class="blob bg-moss" style="width: 300px; height: 300px; bottom: -50px; left: -100px; opacity: 0.2;"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Lewa kolumna – opis newslettera -->
      <div class="lg:col-span-6 fade-up">
        <!-- Eyebrow -->
        <p class="text-sm uppercase tracking-widest text-terra font-semibold mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-terra"></span>
          Newsletter · co tydzień, za darmo
        </p>

        <!-- Headline -->
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-3 leading-tight">
          Newsletter <span class="text-terra">„AI na macierzyńskim"</span>.
        </h2>
        <p class="text-2xl md:text-3xl text-charcoal/60 mb-6 leading-snug font-medium">
          Oswajamy AI po ludzku – jeden mail w tygodniu.
        </p>

        <!-- Lead -->
        <p class="text-lg md:text-xl text-charcoal/75 mb-8 leading-relaxed">
          Zapisujesz się i <strong class="text-charcoal">na start dostajesz Mapę 5 obszarów AI</strong> (PDF).
          Potem co tydzień jeden krótki mail – da się przeczytać między karmieniami.
        </p>

        <!-- Co dostajesz -->
        <ul class="space-y-3 mb-8">
          {dostajesz.map((d) => (
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <p class="text-charcoal/85"><strong class="text-charcoal">{d.label}</strong> {d.text}</p>
            </li>
          ))}
        </ul>

        <!-- Domknięcie: zapis = mapa, mapa = zapis -->
        <div class="inline-flex items-start gap-3 px-4 py-3 bg-terra/10 rounded-xl border border-terra/25">
          <svg class="w-5 h-5 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <p class="text-sm text-charcoal/80 leading-relaxed">
            Zapis na newsletter = Mapa w prezencie. Bierzesz Mapę = jesteś w newsletterze.
            <strong class="text-charcoal">To jedno i to samo.</strong>
          </p>
        </div>
      </div>

      <!-- Prawa kolumna – Mapa + CTA -->
      <div class="lg:col-span-6 fade-up delay-200">
        <div class="bg-white rounded-3xl p-8 md:p-10 shadow-2xl border border-beige-dark/30">
          <!-- Cover Mapy -->
          <div class="mb-6 flex justify-center">
            <div class="relative">
              <div class="absolute -inset-2 bg-gradient-to-br from-terra/30 to-navy/20 rounded-2xl rotate-2"></div>
              <img
                src="/images/mapa-5-obszarow-cover.png"
                alt="Mapa 5 obszarów AI – PDF cover"
                class="relative w-32 md:w-40 rounded-xl shadow-xl"
                onerror="this.style.display='none'"
              />
            </div>
          </div>

          <p class="text-center text-charcoal font-semibold mb-1">Odbierz Mapę i wejdź do newslettera</p>
          <p class="text-center text-sm text-charcoal/55 mb-6">Jeden zapis, dwie rzeczy naraz.</p>

          <!-- CTA button – prowadzi na dedykowany landing zapisu /mapa -->
          <a
            href="/mapa"
            class="inline-flex items-center justify-center gap-2 w-full px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 hover:shadow-xl hover:shadow-terra/30 group"
          >
            <span>Zapisz się · odbierz Mapę</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Mała notka pod formularzem -->
          <p class="text-xs text-charcoal/50 text-center mt-6">
            Po zapisie dostajesz mail z linkiem do PDF (1,5 MB). Wypiszesz się jednym klikiem.
          </p>
        </div>
      </div>
    </div>

    <!-- Podgląd newslettera -->
    <div class="mt-16 text-center fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-semibold mb-6 inline-flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        Tak wygląda jedno wydanie
        <span class="block w-8 h-px bg-terra"></span>
      </p>
      <div class="max-w-sm mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-beige-dark/40">
          <img
            src="/images/newsletter-preview.png"
            alt="Podgląd newslettera „AI na macierzyńskim" – wydanie #1"
            class="w-full block"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-charcoal/50 mt-4">Wydanie #1 · jedna lekcja, jeden prompt, jeden news</p>
      </div>
    </div>
  </div>
</section>
