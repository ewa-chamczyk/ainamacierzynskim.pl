---
// LeadMagnet – sekcja newslettera „AI na macierzyńskim" (#mapa). Dwujęzyczna (prop `lang`).
// PL: zapis = Mapa 5 obszarów AI w prezencie, CTA → /mapa.
// EN: Mapa to PDF po polsku, więc nie obiecujemy jej po angielsku — CTA → /en/newsletter,
//     z jasną informacją, że newsletter jest po polsku.
import { type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    eyebrow: 'Newsletter · co tydzień, za darmo',
    h2a: 'Newsletter',
    h2b: '„AI na macierzyńskim"',
    sub: 'Oswajamy AI po ludzku – jeden mail w tygodniu.',
    leadA: 'Zapisujesz się i',
    leadStrong: 'na start dostajesz Mapę 5 obszarów AI',
    leadB: '(PDF). Potem co tydzień jeden krótki mail – da się przeczytać między karmieniami.',
    items: [
      { label: 'Na start:', text: 'Mapa 5 obszarów AI – pięć konkretów i pięć gotowych promptów, sześć minut czytania.' },
      { label: 'Co tydzień:', text: 'jeden krótki mail – jedna lekcja, jeden prompt do wklejenia, jeden news z AI.' },
      { label: 'Zawsze:', text: 'konkret pod pracę mamy wracającej do gry. Bez żargonu, bez spamu.' },
    ],
    boxA: 'Zapis na newsletter = Mapa w prezencie. Bierzesz Mapę = jesteś w newsletterze.',
    boxStrong: 'To jedno i to samo.',
    cardTitle: 'Odbierz Mapę i wejdź do newslettera',
    cardSub: 'Jeden zapis, dwie rzeczy naraz.',
    cta: 'Zapisz się · odbierz Mapę',
    href: '/mapa',
    note: 'Po zapisie dostajesz mail z linkiem do PDF (1,5 MB). Wypiszesz się jednym klikiem.',
  },
  en: {
    eyebrow: 'Newsletter · weekly, free',
    h2a: 'The newsletter',
    h2b: '„AI na macierzyńskim"',
    sub: 'Making AI human – one email a week.',
    leadA: 'Every Thursday evening you get',
    leadStrong: 'one lesson, one ready-made prompt and one real use case',
    leadB: 'from work. Short enough to read between feeds.',
    items: [
      { label: 'One lesson:', text: 'one concept or one skill, explained without a technical preamble.' },
      { label: 'One prompt:', text: 'ready to copy, with brackets to swap for your own details.' },
      { label: 'One use case:', text: 'a real work situation where it actually helps. No jargon, no spam.' },
    ],
    boxA: 'The newsletter is written in Polish – that is where the whole community is.',
    boxStrong: 'Sessions in the AI Clinic run in Polish or English.',
    cardTitle: 'Join the newsletter',
    cardSub: 'One email a week, nothing more.',
    cta: 'Sign up for the newsletter',
    href: '/en/newsletter',
    note: 'Written in Polish. Unsubscribe in one click, any time.',
  },
}[lang];
---

<section id="mapa" class="relative px-6 py-24 bg-cream overflow-hidden">
  <!-- Dekoracja -->
  <div class="blob bg-terra-soft" style="width: 450px; height: 450px; top: -100px; right: -150px; opacity: 0.35;"></div>
  <div class="blob bg-moss" style="width: 300px; height: 300px; bottom: -50px; left: -100px; opacity: 0.2;"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Lewa kolumna – opis newslettera -->
      <div class="lg:col-span-6 fade-up">
        <!-- Eyebrow -->
        <p class="text-sm uppercase tracking-widest text-terra font-semibold mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-terra"></span>
          {content.eyebrow}
        </p>

        <!-- Headline -->
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-3 leading-tight">
          {content.h2a} <span class="text-terra">{content.h2b}</span>.
        </h2>
        <p class="text-2xl md:text-3xl text-charcoal/60 mb-6 leading-snug font-medium">
          {content.sub}
        </p>

        <!-- Lead -->
        <p class="text-lg md:text-xl text-charcoal/75 mb-8 leading-relaxed">
          {content.leadA} <strong class="text-charcoal">{content.leadStrong}</strong> {content.leadB}
        </p>

        <!-- Co dostajesz -->
        <ul class="space-y-3 mb-8">
          {content.items.map((d) => (
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <p class="text-charcoal/85"><strong class="text-charcoal">{d.label}</strong> {d.text}</p>
            </li>
          ))}
        </ul>

        <!-- Domknięcie: zapis = mapa, mapa = zapis -->
        <div class="inline-flex items-start gap-3 px-4 py-3 bg-terra/10 rounded-xl border border-terra/25">
          <svg class="w-5 h-5 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <p class="text-sm text-charcoal/80 leading-relaxed">
            {content.boxA}
            <strong class="text-charcoal">{content.boxStrong}</strong>
          </p>
        </div>
      </div>

      <!-- Prawa kolumna – Mapa + CTA -->
      <div class="lg:col-span-6 fade-up delay-200">
        <div class="bg-white rounded-3xl p-8 md:p-10 shadow-2xl border border-beige-dark/30">
          <!-- Mapa w tablecie + podgląd newslettera obok -->
          <div class="mb-7 flex items-center justify-center gap-3 float-soft">
            <!-- Mapa 5 obszarów w mock-upie tabletu -->
            <div class="w-[48%] max-w-[210px] shrink-0 bg-white rounded-[1.5rem] p-2.5 shadow-xl border border-beige-dark/40 -rotate-2">
              <div class="rounded-[1.1rem] overflow-hidden bg-cream ring-1 ring-black/5">
                <img
                  src="/images/mapa-5-obszarow-cover.png"
                  alt="Mapa 5 obszarów AI – PDF"
                  class="w-full block"
                  onerror="this.style.display='none'"
                />
              </div>
            </div>
            <!-- Podgląd newslettera obok -->
            <div class="w-[45%] max-w-[190px] shrink-0 rounded-xl overflow-hidden shadow-lg border border-beige-dark/30 rotate-2">
              <img
                src="/images/newsletter-preview.png"
                alt="Podgląd newslettera „AI na macierzyńskim""
                class="w-full block"
                loading="lazy"
              />
            </div>
          </div>

          <p class="text-center text-charcoal font-semibold mb-1">{content.cardTitle}</p>
          <p class="text-center text-sm text-charcoal/55 mb-6">{content.cardSub}</p>

          <!-- CTA button – prowadzi na dedykowany landing zapisu /mapa -->
          <a
            href={content.href}
            class="inline-flex items-center justify-center gap-2 w-full px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 hover:shadow-xl hover:shadow-terra/30 group"
          >
            <span>{content.cta}</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Mała notka pod formularzem -->
          <p class="text-xs text-charcoal/50 text-center mt-6">
            {content.note}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
