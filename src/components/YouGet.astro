---
// Co dostaniesz po zapisie – konkretne wartości, bez "7 promptów" / hack-bullshitu
const benefits = [
  {
    icon: 'gift',
    title: 'Materiał na start: Mapa 5 obszarów AI',
    desc: 'PDF z pięcioma konkretnymi obszarami, w których AI realnie pomaga w pracy. Pięć gotowych promptów. Pięć czerwonych linii – czego AI tu NIE robi. Sześć minut czytania, które oszczędzi Ci tygodnie błądzenia.',
  },
  {
    icon: 'list',
    title: 'Cotygodniowy newsletter',
    desc: 'Jedna lekcja. Jeden konkretny prompt. Jedno realne zastosowanie AI w pracy. Bez nadmiaru, w rytmie macierzyńskiego.',
  },
  {
    icon: 'mail',
    title: 'Pierwsza wiesz o premierach i nowościach',
    desc: 'O każdej nowości – ebooku, kursie, materiałach – wiesz pierwsza. Najpierw do Ciebie, zanim trafi gdziekolwiek indziej.',
  },
  {
    icon: 'star',
    title: 'Pierwszeństwo do kursu',
    desc: 'Pierwsza edycja kursu „AI przed powrotem do pracy" – niższa cena i pierwszeństwo wyłącznie dla osób z listy. Limit miejsc.',
  },
];

const icons = {
  mail: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  list: 'M4 6h16M4 10h16M4 14h16M4 18h16',
  star: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
  gift: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7',
};
---

<section class="relative px-6 py-24 overflow-hidden bg-cream">
  <!-- Dekoracja -->
  <div class="blob bg-terra-soft" style="width: 350px; height: 350px; top: 20%; right: -100px; opacity: 0.3;"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Nagłówek -->
    <div class="mb-16 max-w-3xl fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-medium mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        Co dostaniesz po zapisie
      </p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-6 leading-tight">
        Bez „life-hacków". <br />
        <span class="text-terra">Konkretnie i uczciwie.</span>
      </h2>
      <p class="text-lg text-charcoal/70">
        Nie obiecuję Ci „7 magicznych promptów w 5 minut".
        Obiecuję rzeczy, które naprawdę przydadzą Ci się w pracy. I z których sama korzystam na co dzień.
      </p>
    </div>

    <!-- Lista benefitów -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {benefits.map((benefit, idx) => (
        <div class={`group bg-white rounded-2xl p-8 card-lift fade-up delay-${(idx % 4) * 100} border border-beige-dark/40 flex gap-5`}>
          <!-- Icon -->
          <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-terra/10 flex items-center justify-center group-hover:bg-terra/20 transition-colors">
            <svg class="w-7 h-7 text-terra" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[benefit.icon as keyof typeof icons]} />
            </svg>
          </div>

          <!-- Treść -->
          <div>
            <h3 class="text-lg font-semibold text-charcoal mb-2">
              {benefit.title}
            </h3>
            <p class="text-charcoal/70 leading-relaxed text-sm">
              {benefit.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Soft note -->
    <p class="mt-12 text-center text-sm text-charcoal/50 italic fade-in delay-300">
      Zapisanie jest bezpłatne. Możesz się wypisać w każdej chwili – bez tłumaczenia.
    </p>
  </div>
</section>
