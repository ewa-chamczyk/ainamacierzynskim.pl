---
// NewsletterPage.astro — landing zapisu na newsletter „AI na macierzyńskim".
// Standalone (własny <head>), świadomie bez globalnego menu. Prop `lang` wybiera treść;
// strony /newsletter i /en/newsletter to cienkie opakowania na ten komponent.
//
// MailerLite (konto 2290800): formularz „Newsletter AI na macierzyńskim (landing /newsletter)"
// ID 194764420703847967, single opt-in. Zapis trafia do DWÓCH grup naraz:
//   · ai-na-macierzynskim-newsletter (187343853788857528)
//   · welcome-nurture               (192276891856536605)
// Automatyzacja „ANM Welcome – zapis na newsletter" wysyła podziękowanie od razu.
//
// EN: newsletter jest pisany PO POLSKU — mówimy o tym wprost w kilku miejscach,
// żeby nikt nie zapisał się na treści w języku, którego nie zna.
import { altPath, type Lang } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const ogImage = 'https://ainamacierzynskim.pl/images/og-home.jpg';

const ML_ENDPOINT =
  'https://assets.mailerlite.com/jsonp/2290800/forms/194764420703847967/subscribe';

const content = {
  pl: {
    title: 'Newsletter AI na macierzyńskim – jedna lekcja tygodniowo',
    description: 'Co czwartek wieczorem: jedna lekcja o AI, jeden gotowy prompt i jedno zastosowanie w Twojej pracy. Dla mam wracających do pracy. Bez żargonu, za darmo.',
    canonical: 'https://ainamacierzynskim.pl/newsletter',
    ghost: 'N',
    label: 'Newsletter · AI na macierzyńskim',
    h1a: 'Jedna lekcja AI tygodniowo.',
    h1em: 'Tyle',
    h1b: ', ile zmieści się w&nbsp;drzemce.',
    sub: 'Co czwartek wieczorem dostajesz jedną lekcję, jeden gotowy prompt i&nbsp;jedno zastosowanie w&nbsp;Twojej pracy. Bez żargonu i&nbsp;bez poczucia, że masz nadrobić wszystko naraz.',
    hp: 'Nie wypełniaj tego pola',
    name: 'Imię',
    nameAria: 'Twoje imię',
    email: 'Twój e-mail',
    emailAria: 'Twój adres e-mail',
    submit: 'Zapisz się',
    consent: 'Zapisując się, dostajesz mój newsletter „AI&nbsp;na&nbsp;macierzyńskim" – 1&nbsp;lekcja + 1&nbsp;prompt tygodniowo – oraz zgadzasz się na otrzymywanie ode mnie e-maili marketingowych (newsletter i&nbsp;informacje o&nbsp;moich produktach). Bez spamu, wypiszesz się jednym kliknięciem. <a href="/polityka-prywatnosci">Polityka prywatności</a> · <a href="/regulamin">Regulamin</a>',
    tyH: 'Jesteś na liście.',
    tyP: 'Za chwilę dostaniesz ode mnie krótkie potwierdzenie – sprawdź skrzynkę, zajrzyj też w&nbsp;spam i&nbsp;zakładkę „Oferty". Pierwsze pełne wydanie czeka Cię w&nbsp;najbliższy czwartek wieczorem.',
    h2a: 'Co',
    h2aEm: 'otrzymasz',
    h2aTail: 'co tydzień',
    items: [
      '<strong>Jedną lekcję</strong>, którą zrozumiesz bez technicznego wstępu – jedno pojęcie albo jedna umiejętność naraz',
      '<strong>Jeden prompt</strong> gotowy do skopiowania, z&nbsp;nawiasami do podmiany na Twoje dane',
      '<strong>Jedno zastosowanie</strong> z&nbsp;prawdziwej pracy – mail, spotkanie, raport, rekrutacja',
      '<strong>Jedną czerwoną linię</strong> – czego w&nbsp;tym temacie AI zrobić nie powinno',
      'Wszystko w&nbsp;czwartek wieczorem, krótko. Do przeczytania, kiedy dom już cichnie.',
    ],
    h2b: 'Tak to',
    h2bEm: 'wygląda',
    peekLead: 'Dwa wydania z&nbsp;archiwum – żeby nie zapisywać się w&nbsp;ciemno.',
    cap4: 'Wydanie #4 · Sprawdź, zanim wyślesz',
    cap6: 'Wydanie #6 · Najpierw zadanie',
    alt4: 'Newsletter „AI na macierzyńskim", wydanie 4 – Sprawdź, zanim wyślesz',
    alt6: 'Newsletter „AI na macierzyńskim", wydanie 6 – Najpierw zadanie, potem narzędzie',
    bio: '<strong>Ewa Chamczyk.</strong> Mama, PhD, 3&nbsp;lata w&nbsp;AI (NASK, CampusAI, AI&nbsp;Tact). Uczę mamy wracające do pracy ogarniać AI – po&nbsp;ludzku, w&nbsp;Twoim tempie.',
    closerA: 'Zacznij od',
    closerEm: 'jednej',
    closerB: 'lekcji w&nbsp;tygodniu.',
    langNote: '',
    switchLabel: 'EN',
  },
  en: {
    title: 'AI na macierzyńskim newsletter – one lesson a week',
    description: 'Every Thursday evening: one lesson about AI, one ready-made prompt and one real use case from work. Written in Polish. Free.',
    canonical: 'https://ainamacierzynskim.pl/en/newsletter',
    ghost: 'N',
    label: 'Newsletter · AI na macierzyńskim',
    h1a: 'One AI lesson a week.',
    h1em: 'As much',
    h1b: ' as fits into a nap.',
    sub: 'Every Thursday evening you get one lesson, one ready-made prompt and one real use case from your work. No jargon, and no feeling that you have to catch up on everything at once.',
    hp: 'Do not fill this field',
    name: 'First name',
    nameAria: 'Your first name',
    email: 'Your email',
    emailAria: 'Your email address',
    submit: 'Sign up',
    consent: 'The newsletter is <strong>written in Polish</strong>. By signing up you get „AI&nbsp;na&nbsp;macierzyńskim" – 1&nbsp;lesson + 1&nbsp;prompt a week – and you agree to receive marketing emails from me (the newsletter and news about my products). No spam, unsubscribe in one click. <a href="/polityka-prywatnosci">Privacy policy</a> · <a href="/regulamin">Terms</a> (in Polish)',
    tyH: 'You are on the list.',
    tyP: 'A short confirmation is on its way – check your inbox, and look in spam and the „Promotions" tab too. The first full issue arrives this Thursday evening.',
    h2a: 'What you',
    h2aEm: 'get',
    h2aTail: 'every week',
    items: [
      '<strong>One lesson</strong> you will understand without a technical preamble – one concept or one skill at a time',
      '<strong>One prompt</strong> ready to copy, with brackets to swap for your own details',
      '<strong>One use case</strong> from real work – an email, a meeting, a report, a hiring process',
      '<strong>One red line</strong> – what AI should not do in that particular area',
      'All on Thursday evening, kept short. To read once the house goes quiet.',
    ],
    h2b: 'This is what it',
    h2bEm: 'looks like',
    peekLead: 'Two issues from the archive – so you are not signing up blind.',
    cap4: 'Issue #4 · Check before you send',
    cap6: 'Issue #6 · Task first, tool second',
    alt4: 'AI na macierzyńskim newsletter, issue 4',
    alt6: 'AI na macierzyńskim newsletter, issue 6',
    bio: '<strong>Ewa Chamczyk.</strong> Mother, PhD, 3&nbsp;years in AI (NASK, CampusAI, AI&nbsp;Tact). I help mothers going back to work get to grips with AI – in plain language, at their own pace.',
    closerA: 'Start with',
    closerEm: 'one',
    closerB: 'lesson a week.',
    langNote: 'The newsletter itself is written in Polish. 1:1 sessions in the AI Clinic run in Polish or English.',
    switchLabel: 'PL',
  },
}[lang];

const c = content;
const switchTo: Lang = lang === 'pl' ? 'en' : 'pl';
const switchHref = altPath(Astro.url.pathname, switchTo);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={c.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={c.canonical} />
    <link rel="alternate" hreflang="pl" href="https://ainamacierzynskim.pl/newsletter" />
    <link rel="alternate" hreflang="en" href="https://ainamacierzynskim.pl/en/newsletter" />

    <!-- Open Graph -->
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={c.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:site_name" content="AI na macierzyńskim" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.title} />
    <meta name="twitter:description" content={c.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800;900&family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <title>{c.title}</title>

    <style is:global>
      :root {
        --bordo: #6b1f1f;
        --bordo-mid: #571a1d;
        --wino: #4a1721;
        --wino-2: #3c121b;
        --krem: #f2e9dd;
        --krem-dim: rgba(242, 233, 221, 0.74);
        --peach: #eea679;
        --peach-deep: #d88458;
        --error: #f3b3a0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      /* atrybut hidden musi wygrać z .form{display:flex} i innymi regułami display */
      [hidden] { display: none !important; }
      html { scroll-behavior: smooth; }
      body {
        /* głębokie bordo → wino (bez jasnej czerwieni) + wyraźniejsze poświaty brzoskwiniowe */
        background:
          radial-gradient(620px 420px at 88% -6%, rgba(238, 166, 121, 0.30), transparent 64%),
          radial-gradient(520px 380px at -6% 30%, rgba(216, 132, 88, 0.20), transparent 62%),
          radial-gradient(560px 460px at 72% 103%, rgba(238, 166, 121, 0.17), transparent 64%),
          linear-gradient(170deg, var(--bordo) 0%, var(--bordo-mid) 46%, var(--wino-2) 100%);
        background-attachment: fixed;
        color: var(--krem);
        font-family: 'Archivo', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        min-height: 100vh;
      }
      .wrap { max-width: 820px; margin: 0 auto; padding: 0 28px; position: relative; z-index: 2; }
      .label {
        font-family: 'IBM Plex Mono', monospace; font-weight: 500;
        font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--peach);
        display: inline-flex; align-items: center; gap: 12px;
      }
      .label::before { content: ''; display: block; width: 30px; height: 1px; background: var(--peach); }
      .ghost {
        position: absolute; right: -5vw; top: -5vh;
        font-family: 'Fraunces', serif; font-style: italic; font-weight: 600;
        font-size: 56vw; line-height: 0.7; color: var(--krem); opacity: 0.05;
        pointer-events: none; z-index: 1; user-select: none;
      }

      /* HERO */
      .hero { padding: 62px 0 52px; position: relative; }
      h1 {
        font-family: 'Archivo', sans-serif; font-weight: 900;
        font-size: clamp(38px, 7.4vw, 64px); line-height: 1.03; letter-spacing: -0.03em;
        margin: 18px 0 18px;
      }
      h1 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .sub { font-size: clamp(17px, 2.6vw, 20px); color: var(--krem-dim); max-width: 560px; }

      /* FORM */
      .form { margin: 30px 0 12px; display: flex; flex-wrap: wrap; gap: 10px; max-width: 620px; }
      .form .field {
        flex: 1 1 180px; min-width: 0;
        background: var(--krem); color: var(--wino);
        border: 2px solid transparent; border-radius: 10px; padding: 16px 18px;
        font-family: 'Archivo', sans-serif; font-size: 16px; font-weight: 500;
      }
      .form .field::placeholder { color: rgba(74, 23, 33, 0.55); }
      .form .field:focus-visible { outline: none; border-color: var(--peach); }
      .form button {
        flex: 0 0 auto;
        background: var(--peach); color: var(--wino-2);
        border: none; border-radius: 10px; padding: 16px 28px;
        font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 16px;
        cursor: pointer; transition: transform 0.12s ease, background 0.12s ease;
      }
      .form button:hover { transform: translateY(-2px); background: var(--peach-deep); }
      .form button:disabled { opacity: 0.65; cursor: progress; transform: none; }
      /* honeypot — niewidoczny dla ludzi, łapie boty */
      .hp { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

      .micro { font-size: 13.5px; color: var(--krem-dim); max-width: 560px; }
      .micro a { color: var(--peach); }
      .form-status { margin: 4px 0 12px; font-size: 14.5px; font-weight: 600; color: var(--error); max-width: 560px; }

      /* THANK YOU */
      .thankyou {
        margin: 30px 0 12px; max-width: 560px;
        border: 1px solid rgba(238, 166, 121, 0.45); border-radius: 14px;
        padding: 22px 24px; background: rgba(238, 166, 121, 0.10);
      }
      .thankyou:focus-visible { outline: 2px solid var(--peach); outline-offset: 3px; }
      .thankyou-h { font-size: 20px; font-weight: 800; margin-bottom: 8px; }
      .thankyou-h em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .thankyou p:last-child { color: var(--krem-dim); font-size: 16px; }

      /* SECTIONS */
      /* akcent pomarańczowy zamiast kremowej kreski – rozdziela sekcje i ociepla tło */
      section { padding: 46px 0; border-top: 1px solid rgba(238, 166, 121, 0.22); }
      h2 {
        font-family: 'Archivo', sans-serif; font-weight: 800;
        font-size: clamp(24px, 4.2vw, 32px); letter-spacing: -0.02em; margin-bottom: 22px;
      }
      h2 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .lead-2 { color: var(--krem-dim); font-size: 17px; max-width: 560px; margin: -10px 0 26px; }
      ul { list-style: none; display: grid; gap: 15px; }
      li { position: relative; padding-left: 30px; font-size: 17px; color: var(--krem); }
      li::before { content: '→'; position: absolute; left: 0; top: 0; color: var(--peach); font-weight: 800; }
      li strong { font-weight: 800; }

      /* PODGLĄD WYDAŃ – miniatury prawdziwych newsletterów */
      .peek { display: flex; gap: 20px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
      .peek figure {
        width: min(46%, 260px);
        background: var(--krem); border-radius: 14px; padding: 9px;
        box-shadow: 0 24px 50px rgba(35, 10, 15, 0.45);
        animation: floatSoft 7s ease-in-out infinite;
      }
      .peek figure:nth-child(1) { transform: rotate(-2deg); }
      .peek figure:nth-child(2) { transform: rotate(2deg); animation-delay: -3.5s; }
      .peek .shot {
        border-radius: 8px; overflow: hidden; background: var(--wino);
        /* pokazujemy górę wydania, resztę przycinamy – to ma być miniatura, nie całe wydanie */
        max-height: 300px;
      }
      /* height:auto jest konieczne – bez niego atrybut height="1860" wymusza wysokość i ściska obraz */
      .peek img { width: 100%; height: auto; display: block; }
      .peek figcaption {
        font-family: 'IBM Plex Mono', monospace; font-weight: 500;
        font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--wino); text-align: center; padding: 10px 4px 4px;
      }
      @keyframes floatSoft {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -9px; }
      }

      /* BIO */
      .bio { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
      .bio .avatar {
        width: 84px; height: 84px; border-radius: 50%; flex: 0 0 auto;
        background: linear-gradient(135deg, var(--peach), var(--peach-deep));
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif; font-style: italic; font-weight: 600;
        font-size: 34px; color: var(--wino-2);
      }
      .bio p { font-size: 17px; color: var(--krem-dim); max-width: 540px; }
      .bio strong { color: var(--krem); font-weight: 800; }

      /* CLOSER */
      .closer h2 { margin-bottom: 24px; }

      footer { padding: 40px 0 56px; text-align: center; }
      .handle { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 13px; letter-spacing: 0.08em; color: var(--krem-dim); }

      .langswitch {
        position: absolute; top: 22px; right: 28px; z-index: 5;
        font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 12px;
        letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
        color: var(--krem-dim); border: 1px solid rgba(238, 166, 121, 0.4);
        border-radius: 8px; padding: 7px 12px; transition: color 0.15s, border-color 0.15s;
      }
      .langswitch:hover { color: var(--peach); border-color: var(--peach); }
      .langnote {
        display: inline-block; margin: 16px 0 0; padding: 9px 14px;
        font-size: 14px; color: var(--peach); line-height: 1.45; max-width: 560px;
        border: 1px solid rgba(238, 166, 121, 0.45); border-radius: 10px;
        background: rgba(238, 166, 121, 0.10);
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .form button { transition: none; }
        .peek figure { animation: none; }
      }
    </style>
  </head>
  <body>
    <div class="ghost" aria-hidden="true">{c.ghost}</div>
    <a class="langswitch" href={switchHref} hreflang={switchTo}>{c.switchLabel}</a>

    <header class="hero">
      <div class="wrap">
        <span class="label">{c.label}</span>
        <h1>{c.h1a} <em>{c.h1em}</em><Fragment set:html={c.h1b} /></h1>
        <p class="sub">
          <Fragment set:html={c.sub} />
        </p>
        {c.langNote && <p class="langnote">{c.langNote}</p>}

        <div class="cta">
          <form class="form" data-ml-form method="POST" action={ML_ENDPOINT} target="_blank">
            <label class="hp" aria-hidden="true">{c.hp}<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
            <input type="text" name="fields[name]" required autocomplete="given-name" placeholder={c.name} aria-label={c.nameAria} class="field" />
            <input type="email" name="fields[email]" required autocomplete="email" placeholder={c.email} aria-label={c.emailAria} class="field" />
            <input type="hidden" name="anticsrf" value="true" />
            <input type="hidden" name="ml-submit" value="1" />
            <button type="submit">{c.submit}</button>
          </form>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
          <p class="micro" set:html={c.consent}></p>
          <div class="thankyou" hidden tabindex="-1">
            <p class="thankyou-h"><em>{c.tyH}</em></p>
            <p set:html={c.tyP}></p>
          </div>
        </div>
      </div>
    </header>

    <section>
      <div class="wrap">
        <h2>{c.h2a} <em>{c.h2aEm}</em> {c.h2aTail}</h2>
        <ul>
          {c.items.map((i) => <li set:html={i} />)}
        </ul>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>{c.h2b} <em>{c.h2bEm}</em></h2>
        <p class="lead-2" set:html={c.peekLead}></p>
        <div class="peek">
          <figure>
            <div class="shot">
              <img src="/images/newsletter-wydanie-04.png" alt={c.alt4} loading="lazy" width="1320" height="1860" />
            </div>
            <figcaption>{c.cap4}</figcaption>
          </figure>
          <figure>
            <div class="shot">
              <img src="/images/newsletter-wydanie-06.png" alt={c.alt6} loading="lazy" width="1320" height="1860" />
            </div>
            <figcaption>{c.cap6}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap bio">
        <div class="avatar" aria-hidden="true">E</div>
        <p set:html={c.bio}></p>
      </div>
    </section>

    <section class="closer">
      <div class="wrap">
        <h2>{c.closerA} <em>{c.closerEm}</em> <Fragment set:html={c.closerB} /></h2>
        <div class="cta">
          <form class="form" data-ml-form method="POST" action={ML_ENDPOINT} target="_blank">
            <label class="hp" aria-hidden="true">{c.hp}<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
            <input type="text" name="fields[name]" required autocomplete="given-name" placeholder={c.name} aria-label={c.nameAria} class="field" />
            <input type="email" name="fields[email]" required autocomplete="email" placeholder={c.email} aria-label={c.emailAria} class="field" />
            <input type="hidden" name="anticsrf" value="true" />
            <input type="hidden" name="ml-submit" value="1" />
            <button type="submit">{c.submit}</button>
          </form>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
          <p class="micro" set:html={c.consent}></p>
          <div class="thankyou" hidden tabindex="-1">
            <p class="thankyou-h"><em>{c.tyH}</em></p>
            <p set:html={c.tyP}></p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <span class="handle">@ai.na.macierzynskim</span>
    </footer>

    <script is:inline>
      (function () {
        var ENDPOINT =
          'https://assets.mailerlite.com/jsonp/2290800/forms/194764420703847967/subscribe';
        var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

        function setStatus(el, msg) {
          if (!el) return;
          el.textContent = msg;
          el.hidden = false;
        }
        function clearStatus(el) {
          if (!el) return;
          el.textContent = '';
          el.hidden = true;
        }
        function showThankYou(cta) {
          var form = cta.querySelector('form');
          var micro = cta.querySelector('.micro');
          var status = cta.querySelector('.form-status');
          var ty = cta.querySelector('.thankyou');
          if (form) form.hidden = true;
          if (micro) micro.hidden = true;
          clearStatus(status);
          if (ty) {
            ty.hidden = false;
            try { ty.focus(); } catch (e) {}
          }
        }
        function firstError(data) {
          try {
            var f = data.errors.fields;
            for (var k in f) { if (f[k] && f[k][0]) return f[k][0]; }
          } catch (e) {}
          return '';
        }

        var forms = document.querySelectorAll('form[data-ml-form]');
        Array.prototype.forEach.call(forms, function (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var cta = form.closest('.cta');
            var status = cta.querySelector('.form-status');
            var btn = form.querySelector('button[type="submit"]');
            var emailInput = form.querySelector('input[type="email"]');
            var hp = form.querySelector('input[name="hp_website"]');

            // bot: honeypot wypełniony → udajemy sukces, nic nie wysyłamy
            if (hp && hp.value) { showThankYou(cta); return; }

            var email = (emailInput.value || '').trim();
            if (!EMAIL_RE.test(email)) {
              setStatus(status, 'Podaj poprawny adres e-mail.');
              emailInput.focus();
              return;
            }

            clearStatus(status);
            var original = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Wysyłam…';

            var fd = new FormData(form);
            fd.delete('hp_website');

            fetch(ENDPOINT, {
              method: 'POST',
              body: fd,
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
            })
              .then(function (res) {
                return res.json().catch(function () { return { success: res.ok }; });
              })
              .then(function (data) {
                if (data && data.success) {
                  showThankYou(cta);
                } else {
                  var err = firstError(data);
                  if (/valid email/i.test(err)) err = 'Podaj poprawny adres e-mail.';
                  setStatus(status, err || 'Coś nie zadziałało. Spróbuj jeszcze raz.');
                  btn.disabled = false;
                  btn.textContent = original;
                }
              })
              .catch(function () {
                setStatus(status, 'Brak połączenia. Spróbuj jeszcze raz za chwilę.');
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      })();
    </script>
  </body>
</html>
