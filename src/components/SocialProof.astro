---
// Social proof – 1 emocjonalny + 2 wymierne (z konkretnym efektem zawodowym)
// PRZYKŁADY – Ewa wstawi prawdziwe testimoniale jak dostanie zgody od koleżanek
const quotes = [
  {
    type: 'emocjonalny',
    text: 'Wreszcie ktoś powiedział głośno, że nie muszę być wdzięczna za to, że pozwolą mi wrócić. To nie jest poradnik. To jest tarcza',
    author: 'Katarzyna, wraca do pracy za 6 tygodni',
    effect: null,
  },
  {
    type: 'wymierny',
    text: 'Przeczytałam między karmieniami. Trzy dni później wynegocjowałam zdalny piątek z szefem',
    author: 'Monika, kierowniczka projektów, mama Heleny',
    effect: 'Zdalny piątek od poniedziałku po lekturze',
  },
  {
    type: 'wymierny',
    text: 'Po liście 4 napisałam mailem warunki powrotu. Bez przepraszania, bez trzech akapitów o tym, jak mi zależy. Pierwszy raz w życiu',
    author: 'Aneta, founderka, mama Jasia',
    effect: 'Pierwszy mail bez przepraszania',
  },
];
---

<section class="relative px-6 py-24 bg-beige/40 overflow-hidden">
  <!-- Dekoracja -->
  <div class="blob bg-navy-light" style="width: 400px; height: 400px; bottom: -100px; right: 10%; opacity: 0.2;"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Nagłówek -->
    <div class="mb-16 max-w-3xl fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-medium mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        Pierwsze czytelniczki
      </p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-6 leading-tight">
        Zanim trafi do Ciebie, <br />
        <span class="text-terra">przeczytały to one.</span>
      </h2>
      <p class="text-lg text-charcoal/70">
        Tak zareagowały kobiety, które dostały ebooka przed Tobą.
      </p>
    </div>

    <!-- Cytaty -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {quotes.map((q, idx) => (
        <figure class={`relative bg-white rounded-2xl p-8 card-lift fade-up delay-${idx * 100} border border-beige-dark/40 flex flex-col`}>
          <!-- Big quote mark -->
          <svg class="absolute top-4 right-6 w-16 h-16 text-terra/15" fill="currentColor" viewBox="0 0 24 24">
            <path d="M7.17 4C3.97 4 1.5 6.47 1.5 9.67c0 3.21 2.47 5.68 5.67 5.68v2.65c0 .55-.45 1-1 1H4.5c-.55 0-1 .45-1 1s.45 1 1 1h2c1.65 0 3-1.35 3-3v-3.65c3.2 0 5.67-2.47 5.67-5.68C15.17 6.47 12.7 4 9.5 4H7.17zm9 0c-3.2 0-5.67 2.47-5.67 5.67 0 3.21 2.47 5.68 5.67 5.68v2.65c0 .55-.45 1-1 1H13.5c-.55 0-1 .45-1 1s.45 1 1 1h2c1.65 0 3-1.35 3-3v-3.65c3.2 0 5.67-2.47 5.67-5.68C24.17 6.47 21.7 4 18.5 4h-2.33z"/>
          </svg>

          <blockquote class="flex-1 flex flex-col relative">
            <p class="text-charcoal/85 leading-relaxed mb-6 text-base">
              „{q.text}”.
            </p>

            <!-- Effect badge (only for wymierne) -->
            {q.effect && (
              <div class="mb-6 inline-flex items-start gap-2 px-3 py-2 bg-terra/8 rounded-lg text-xs text-terra font-semibold self-start">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>{q.effect}</span>
              </div>
            )}

            <figcaption class="flex items-center gap-3 mt-auto pt-4 border-t border-beige-dark/30">
              <span class="w-10 h-10 rounded-full bg-terra/15 flex items-center justify-center text-terra font-semibold text-sm">
                {q.author.charAt(0)}
              </span>
              <span class="text-sm text-charcoal/60 font-medium">
                {q.author}
              </span>
            </figcaption>
          </blockquote>
        </figure>
      ))}
    </div>

    <!-- Disclaimer -->
    <p class="mt-8 text-xs text-charcoal/40 text-center fade-in delay-300">
      Opinie pierwszych czytelniczek. Cytowane za zgodą – imiona zachowane prywatne.
    </p>
  </div>
</section>
