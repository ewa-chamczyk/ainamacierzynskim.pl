---
// Hero – cytat researchu w headline, lead magnet primary CTA, ebook 48 zł secondary
// Update: 19.05.2026 – zwężenie do menedżerek + Mapa 5 obszarów
---

<section class="relative min-h-screen flex items-center px-6 py-20 overflow-hidden">
  <!-- Dekoracyjne blob'y -->
  <div class="blob bg-terra-soft" style="width: 500px; height: 500px; top: -100px; right: -150px;"></div>
  <div class="blob bg-navy-light" style="width: 400px; height: 400px; bottom: -100px; left: -100px; opacity: 0.25;"></div>

  <!-- Subtle grid -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(var(--color-charcoal) 1px, transparent 1px), linear-gradient(90deg, var(--color-charcoal) 1px, transparent 1px); background-size: 80px 80px;"></div>

  <div class="max-w-6xl mx-auto w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Lewa kolumna – tekst -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <!-- Headline – mix-font: Archivo Black + Fraunces italic akcent w terakocie -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl mb-8 fade-up delay-100 leading-[1.02] tracking-tight">
          <span class="font-black">Wypadłaś</span><br />
          <em class="font-serif italic font-semibold text-terra">z&nbsp;obiegu?</em><br />
          <span class="font-black text-wine/35">Wszyscy biegną z&nbsp;AI?</span><br />
          <span class="font-black text-wine/35">Ty stoisz?</span><br />
          <em class="font-serif italic font-semibold text-terra">Aż do teraz.</em>
        </h1>

        <!-- Lead -->
        <p class="text-xl md:text-2xl text-wine/75 mb-10 fade-up delay-200 leading-relaxed">
          Pomagam <strong class="text-wine">menedżerkom i&nbsp;specjalistkom wracającym po macierzyńskim do pracy</strong>
          ogarnąć AI. Po ludzku, w&nbsp;Twoim tempie.
        </p>

        <!-- CTA – jedno działanie: darmowa Mapa (newsletter). Ebook żyje w sekcji niżej + w menu. -->
        <div class="fade-up delay-300">
          <a
            href="#mapa"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 hover:shadow-2xl hover:shadow-terra/30 group"
          >
            <span>Zapisz się · odbierz Mapę</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Prawa kolumna – zdjęcie -->
      <div class="lg:col-span-5 order-1 lg:order-2 fade-up delay-200">
        <div class="relative">
          <!-- Decorative frame -->
          <div class="absolute -inset-3 bg-gradient-to-br from-terra/20 to-navy/20 rounded-3xl -rotate-2"></div>
          <div class="absolute -inset-1 bg-terra/10 rounded-3xl rotate-1"></div>

          <!-- Photo – sesja Grzedziński 8261 (vertical portrait, kontakt wzrokowy) -->
          <img
            src="/images/ewa-grz-8261-web.jpg"
            alt="Ewa Chamczyk – ekspertka AI, mama"
            class="relative w-full aspect-[4/5] object-cover rounded-3xl shadow-2xl"
          />

          <!-- Floating badge – sygnatura -->
          <div class="absolute -bottom-4 -left-4 md:-left-8 bg-white rounded-2xl px-5 py-3 shadow-xl border border-beige-dark/40">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-terra">
              Ekspertka AI · mama
            </p>
            <p class="text-sm font-semibold text-wine mt-1">
              Ewa Chamczyk
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
