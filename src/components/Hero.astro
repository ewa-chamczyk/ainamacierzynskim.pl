---
// Hero – nagłówek + lead + jedno CTA (newsletter, kotwica do formularza w #mapa).
// Dwujęzyczny (prop `lang`).
// Bez dekoracji generycznych (bloby, siatka, obrócone ramki, pływająca plakietka) —
// jedyny akcent to odręczny dopisek na brzoskwiniowej karteczce, ten sam zabieg
// co na landingu kursu „Menu z głowy”.
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    l1: 'Wypadłaś',
    l2: 'z obiegu?',
    l3: 'Wszyscy biegną z AI? Ty stoisz?',
    l4: 'Aż do teraz.',
    leadA: 'Pomagam mamom',
    leadStrong: 'oszczędzać czas dzięki AI',
    leadB: 'i przygotować się na powrót do pracy. Małe kroki, konkretne zastosowania, w rytmie życia mamy.',
    cta: 'Zapisz się · odbierz Mapę',
    dopisek: 'Nie musisz nadrabiać wszystkiego naraz.',
    alt: 'Ewa Chamczyk – ekspertka AI, mama',
  },
  en: {
    l1: 'Out of',
    l2: 'the loop?',
    l3: 'Everyone racing with AI? And you stand still?',
    l4: 'Until now.',
    leadA: 'I help mothers',
    leadStrong: 'save time with AI',
    leadB: 'and get ready to go back to work. Small steps, concrete use cases, at the pace of life with a child.',
    cta: 'Join the newsletter',
    dopisek: 'You do not have to catch up on everything at once.',
    alt: 'Ewa Chamczyk – AI expert and mother',
  },
}[lang];
---

<section class="relative min-h-screen flex items-center px-6 py-20">
  <div class="max-w-6xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Lewa kolumna – tekst -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <!-- Nagłówek – mix-font: Archivo Black + Fraunces italic w terakocie.
             Linia 3 („Wszyscy biegną z AI? Ty stoisz?”) jest dłuższa, więc idzie
             mniejszym stopniem i w przygaszonym winie — jak drugi plan. -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl mb-8 fade-up delay-100 leading-[1.02] tracking-tight">
          <span class="font-black">{content.l1}</span><br />
          <em class="font-serif italic font-semibold text-terra">{content.l2}</em>
          <span class="block mt-4 mb-3 text-2xl md:text-3xl lg:text-4xl font-black text-wine/35 leading-[1.15]">
            {content.l3}
          </span>
          <em class="font-serif italic font-semibold text-terra">{content.l4}</em>
        </h1>

        <!-- Lead -->
        <p class="text-xl md:text-2xl text-wine/75 mb-10 fade-up delay-200 leading-relaxed max-w-2xl">
          {content.leadA} <strong class="text-wine">{content.leadStrong}</strong>
          {content.leadB}
        </p>

        <!-- CTA – jedno działanie: zapis. Formularz stoi niżej, w sekcji #mapa. -->
        <div class="fade-up delay-300">
          <a
            href="#mapa"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-colors group"
          >
            <span>{content.cta}</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Prawa kolumna – zdjęcie + odręczny dopisek -->
      <div class="lg:col-span-5 order-1 lg:order-2 fade-up delay-200">
        <div class="relative">
          <!-- Photo – sesja Grzedziński 8261 (vertical portrait, kontakt wzrokowy) -->
          <img
            src="/images/ewa-grz-8261-web.jpg"
            alt={content.alt}
            class="w-full aspect-[4/5] object-cover rounded-3xl"
          />

          <p class="sticky-note absolute -bottom-5 -left-3 md:-left-8 max-w-[15rem] text-xl md:text-2xl">
            {content.dopisek}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
