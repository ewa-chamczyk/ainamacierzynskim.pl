---
// FAQ – accordion. <details>/<summary> dla zero-JS approach.
const faqs = [
  {
    q: 'Muszę coś umieć z AI, zanim się zapiszę?',
    a: 'Nie. Wręcz przeciwnie – to miejsce jest właśnie dla tych, które nie wiedzą, od czego zacząć. Nie zrobię z Ciebie ekspertki. Pokażę Ci, co warto wiedzieć, żebyś wracała do pracy z większym spokojem.',
  },
  {
    q: 'Co dostanę w newsletterze?',
    a: 'Jedną lekcję tygodniowo. Jeden konkretny prompt. Jedno realne zastosowanie. W rytmie życia z dzieckiem – bo o to chodzi. Plus na start: 7 promptów przed powrotem do pracy.',
  },
  {
    q: 'Czy newsletter jest płatny?',
    a: 'Newsletter jest bezpłatny i taki pozostaje. Płatne są tylko produkty – ebook i kurs (jak będzie gotowy). Newsletter to miejsce, w którym poznajesz markę bez ryzyka.',
  },
  {
    q: 'Czym jest ebook „Nie zniknęłaś"?',
    a: '7 emocjonalnych listów do mam wracających do pracy. Nie o AI – o powrocie do siebie zawodowo. Bez „daj radę", bez coachingu, bez obietnicy, że „wszystko się ułoży".',
  },
  {
    q: 'Kiedy będzie kurs?',
    a: 'Pierwsza edycja kursu „AI przed powrotem do pracy" planowana jest po premierze ebooka. Najszybciej dowiesz się o niej z newslettera – zapisane otrzymają informację z wyprzedzeniem i niższą cenę za pierwszą edycję.',
  },
  {
    q: 'Faktura?',
    a: 'Tak. Każdy zakup = automatyczna faktura VAT. Jeśli kupujesz na firmę – wpisz NIP w checkoucie. Jeśli prywatnie – dostaniesz fakturę uproszczoną.',
  },
  {
    q: 'Co zrobisz z moim e-mailem?',
    a: 'Nic poza tym, na co się umówimy. Newsletter raz w tygodniu, ewentualnie informacja o premierach produktów. Bez sprzedawania danych, bez spamu, bez „specjalnych ofert partnerów". Wypisujesz się jednym klikiem w każdej chwili.',
  },
];
---

<section class="relative px-6 py-24 bg-cream overflow-hidden">
  <!-- Dekoracja -->
  <div class="blob bg-terra-soft" style="width: 350px; height: 350px; top: 50%; right: -100px; opacity: 0.3;"></div>

  <div class="max-w-3xl mx-auto relative z-10">
    <!-- Nagłówek sekcji -->
    <div class="mb-16 text-center fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-medium mb-4 flex items-center justify-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        Najczęściej pytasz
        <span class="block w-8 h-px bg-terra"></span>
      </p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal">
        FAQ
      </h2>
    </div>

    <!-- Lista FAQ -->
    <div class="space-y-4">
      {
        faqs.map((faq, idx) => (
          <details
            class={`group bg-white rounded-2xl border border-beige-dark/40 overflow-hidden card-lift fade-up delay-${(idx % 5) * 100}`}
          >
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none gap-4">
              <h3 class="text-lg font-semibold text-charcoal pr-4">
                {faq.q}
              </h3>
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-terra/10 flex items-center justify-center text-terra transition-transform group-open:rotate-45">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 -mt-2">
              <div class="pt-4 border-t border-beige-dark/30">
                <p class="text-charcoal/75 leading-relaxed">
                  {faq.a}
                </p>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center fade-up">
      <p class="text-charcoal/60 text-sm mb-4">
        Masz inne pytanie?
      </p>
      <a
        href="https://ig.me/m/ainamacierzynskim"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-terra hover:text-terra-dark font-medium transition-colors"
      >
        Napisz do mnie na Instagramie
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
