---
// Gabinet.astro — teaser flagowego produktu „Gabinet AI" (konsultacja 1:1) na stronie głównej.
// Pełna strona + rezerwacja: /gabinet-ai. Dwujęzyczny (prop `lang`).
import { path, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    eyebrow: 'Gabinet AI · konsultacja 1:1',
    h2a: 'Wolisz przejść to ze mną –',
    h2em: 'jeden na jeden',
    lead: 'Prywatna godzina dla mamy wracającej do pracy po macierzyńskim. Pracujemy na Twoich zadaniach – wychodzisz ze ściągą, biblioteką promptów i tygodniem na dopięcie.',
    punkty: [
      'Godzina 1:1 online, pod Twoje zadania',
      'Ściąga i biblioteka promptów po sesji',
      'Tydzień na dopięcie, żeby weszło w nawyk',
    ],
    cta1: 'Umów wizytę',
    cta2: 'Zobacz szczegóły',
    quote: 'Na szkoleniu poznajesz narzędzia. W Gabinecie wychodzisz z AI ustawionym pod swoje zadania.',
    price: '497 zł · godzina online · kilka miejsc w miesiącu.',
  },
  en: {
    eyebrow: 'AI Clinic · 1:1 session',
    h2a: 'Would you rather do this with me –',
    h2em: 'one to one',
    lead: 'A private hour for a mother going back to work. We work on your actual tasks – you leave with a cheat sheet, a prompt library and a week to make it stick.',
    punkty: [
      'One hour 1:1 online, built around your tasks',
      'Cheat sheet and prompt library after the session',
      'A week of follow-up so it becomes a habit',
    ],
    cta1: 'Book a session',
    cta2: 'See the details',
    quote: 'A training course shows you the tools. In the Clinic you leave with AI set up around your own work.',
    price: 'PLN 497 · one hour online · a few slots a month · in Polish or English.',
  },
}[lang];
---

<section id="gabinet" class="relative px-6 py-24 bg-wine text-cream overflow-hidden">
  <div class="blob bg-terra" style="width: 420px; height: 420px; top: -160px; left: -100px; opacity: 0.28;"></div>
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 30px 30px;"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Lewa: oferta -->
      <div class="lg:col-span-7 fade-up">
        <p class="eyebrow mb-5 flex items-center gap-3" style="color: var(--color-terra-light);">
          <span class="block w-8 h-px bg-terra-light"></span>
          {content.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-6">
          {content.h2a}
          <em class="font-serif italic font-semibold text-terra-light">{content.h2em}</em>?
        </h2>
        <p class="text-cream/75 leading-relaxed text-lg mb-7 max-w-xl">
          {content.lead}
        </p>
        <ul class="space-y-3 mb-9">
          {content.punkty.map((p) => (
            <li class="flex items-center gap-3 text-cream/85">
              <svg class="w-5 h-5 text-terra-light flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={path('/gabinet-ai', lang)}
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 group"
          >
            <span>{content.cta1}</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href={path('/gabinet-ai', lang)}
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent hover:bg-cream/10 text-cream font-semibold rounded-xl border-2 border-cream/25 hover:border-cream/50 transition-all"
          >
            {content.cta2}
          </a>
        </div>
      </div>

      <!-- Prawa: akcent / dostępność -->
      <div class="lg:col-span-5 fade-up delay-200">
        <div class="bg-cream/5 border border-cream/15 rounded-2xl p-8">
          <p class="font-serif italic text-2xl md:text-3xl text-cream mb-5 leading-snug">
            {content.quote}
          </p>
          <p class="text-cream/60 text-sm leading-relaxed">
            {content.price}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
