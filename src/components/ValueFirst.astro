---
// Value-first – daje wartość zanim sprzedaje. 3 rzeczy które warto wiedzieć. Dwujęzyczny (prop `lang`).
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    eyebrow: 'Zanim zaczniesz',
    h2a: '3 rzeczy o AI,',
    h2b: 'które warto rozumieć.',
    lead: 'Zanim zapiszesz się, zanim kupisz ebooka, zanim zaczniesz cokolwiek. Te trzy rzeczy zaoszczędzą Ci dużo czasu i frustracji.',
    insights: [
      {
        n: '01',
        title: 'AI nie jest Twoim asystentem osobistym.',
        body: 'Nie ogarnie za Ciebie życia z dzieckiem. Nie uśpi go, nie odpowie na pytania z infolinii ZUS-u. Ale przy każdej decyzji zawodowej – kiedy budujesz biznes, kiedy negocjujesz z klientami, kiedy odpowiadasz na trudnego maila – jest narzędziem, które oddaje Ci czas i pewność. Tyle. I aż tyle.',
      },
      {
        n: '02',
        title: 'Większość kursów AI nie jest dla Ciebie.',
        body: 'Są albo dla deweloperów (techniczne, „pip install langchain") albo dla „biznesu" (uniwersalne, abstrakcyjne). Nie ma tam Twojej perspektywy: kobiety, która wraca do pracy po macierzyńskim, między karmieniem a drzemką. Tu robimy konkrety – z tej drugiej strony.',
      },
      {
        n: '03',
        title: 'Najszybciej uczysz się robiąc, nie czytając.',
        body: 'Dlatego newsletter to „jedno zastosowanie tygodniowo", nie „30 narzędzi w 5 minut". Czas między drzemkami szanujemy. Lepiej raz na tydzień zrobić coś z AI, niż przeczytać dziesięć artykułów i zamknąć przeglądarkę, bo dziecko właśnie się obudziło.',
      },
    ],
  },
  en: {
    eyebrow: 'Before you start',
    h2a: '3 things about AI',
    h2b: 'worth understanding.',
    lead: 'Before you subscribe, before you buy the ebook, before you start anything. These three will save you a lot of time and frustration.',
    insights: [
      {
        n: '01',
        title: 'AI is not your personal assistant.',
        body: 'It will not run your life with a small child. It will not get the baby to sleep or sit on hold with the benefits office. But in every professional decision – building a business, negotiating with clients, answering a difficult email – it is a tool that gives you back time and confidence. That is all. And that is a lot.',
      },
      {
        n: '02',
        title: 'Most AI courses are not built for you.',
        body: 'They are either for developers (technical, „pip install langchain") or for „business" (generic, abstract). Your perspective is missing: a woman going back to work after maternity leave, between a feed and a nap. Here we get specific – from that other side.',
      },
      {
        n: '03',
        title: 'You learn fastest by doing, not reading.',
        body: 'That is why the newsletter is „one use case a week", not „30 tools in 5 minutes". We respect the time between naps. Better to actually do one thing with AI each week than read ten articles and close the browser because the baby just woke up.',
      },
    ],
  },
}[lang];
---

<section class="relative px-6 py-24 bg-beige/30 overflow-hidden">
  <!-- Dekoracja -->
  <div class="blob bg-navy-light" style="width: 400px; height: 400px; top: 30%; left: -100px; opacity: 0.2;"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Nagłówek -->
    <div class="mb-16 max-w-3xl fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-medium mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        {content.eyebrow}
      </p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-6 leading-tight">
        {content.h2a} <br />
        <span class="text-terra">{content.h2b}</span>
      </h2>
      <p class="text-lg text-charcoal/70">
        {content.lead}
      </p>
    </div>

    <!-- Insights -->
    <div class="space-y-12">
      {content.insights.map((insight, idx) => (
        <article class={`grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 fade-up delay-${idx * 100}`}>
          <!-- Numer -->
          <div class="md:col-span-2">
            <span class="text-6xl md:text-7xl font-semibold text-terra/40 leading-none">
              {insight.n}
            </span>
          </div>

          <!-- Treść -->
          <div class="md:col-span-10 pt-2">
            <h3 class="text-2xl md:text-3xl font-semibold text-charcoal mb-4 leading-snug">
              {insight.title}
            </h3>
            <p class="text-lg text-charcoal/75 leading-relaxed">
              {insight.body}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
