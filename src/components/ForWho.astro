---
// 3 persony z różnymi kolorami akcentu + duże numery + hover lift. Dwujęzyczny (prop `lang`).
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'pl' } = Astro.props;

const content = {
  pl: {
    eyebrow: 'Dla kogo',
    h2: 'Czy to jest dla mnie?',
    lead: 'Trzy historie, w których być może zobaczysz siebie. Każdą znam – od koleżanek, klientek i z własnego doświadczenia.',
    personas: [
      {
        kicker: 'Wracam i się boję',
        quote: '„Wszyscy w zespole już używają AI, a ja stoję z wózkiem".',
        body: 'Boisz się, że w czasie macierzyńskiego świat odjechał. Że wrócisz do firmy, w której zasady się zmieniły, a Ty zostałaś z pieluchami zamiast laptopa.',
      },
      {
        kicker: 'Mózg w trybie czuwania',
        quote: '„Tęsknię za sobą sprzed porodu".',
        body: 'Chcesz kontaktu z czymś rozwojowym, ale nie masz energii na ambitny projekt. Potrzebujesz lekkości, intelektualnego kontaktu i poczucia, że „jeszcze jestem sobą".',
      },
      {
        kicker: 'Boję się, że nie ogarnę',
        quote: '„Tyle się zdarzyło w ciągu roku – nie wiem, czy ogarnę".',
        body: 'ChatGPT, agenci, nowe narzędzia, nowe procesy w zespole. W rok poza biurem AI urosło razy dziesięć. Potrzebujesz mapy, nie kolejnej listy 50 aplikacji do samodzielnego testowania.',
      },
    ],
    footnote: 'A może w każdej trochę. To też jest OK.',
  },
  en: {
    eyebrow: 'Who this is for',
    h2: 'Is this for me?',
    lead: 'Three stories you might recognise yourself in. I know each of them – from friends, from clients and from my own experience.',
    personas: [
      {
        kicker: 'Going back, and scared',
        quote: '„Everyone on the team already uses AI, and I am standing here with a pram".',
        body: 'You are afraid the world moved on while you were on leave. That you will return to a company where the rules changed, and you were left with nappies instead of a laptop.',
      },
      {
        kicker: 'Brain on standby',
        quote: '„I miss the person I was before giving birth".',
        body: 'You want something that stretches your mind, but you have no energy for an ambitious project. You need lightness, a bit of intellectual contact and the feeling that you are still yourself.',
      },
      {
        kicker: 'Afraid it is too much',
        quote: '„So much happened in a year – I am not sure I can catch up".',
        body: 'ChatGPT, agents, new tools, new team processes. In one year out of the office, AI grew tenfold. You need a map, not another list of 50 apps to test on your own.',
      },
    ],
    footnote: 'Or maybe a little of each. That is fine too.',
  },
}[lang];

const accents = [
  { border: 'border-terra', numeral: 'text-terra', kicker: 'text-terra', delay: 'delay-100' },
  { border: 'border-navy', numeral: 'text-navy', kicker: 'text-navy', delay: 'delay-200' },
  { border: 'border-moss', numeral: 'text-moss', kicker: 'text-moss', delay: 'delay-300' },
];
---

<section class="relative px-6 py-24 bg-beige/40 overflow-hidden">
  <!-- Dekoracja w tle -->
  <div class="blob bg-terra-soft" style="width: 350px; height: 350px; top: 20%; right: -100px; opacity: 0.3;"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Nagłówek sekcji -->
    <div class="mb-16 max-w-3xl fade-up">
      <p class="text-sm uppercase tracking-widest text-terra font-medium mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        {content.eyebrow}
      </p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal mb-6">
        {content.h2}
      </h2>
      <p class="text-lg text-charcoal/70">
        {content.lead}
      </p>
    </div>

    <!-- Karty -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {content.personas.map((p, i) => (
        <div class={`relative bg-white rounded-3xl p-8 card-lift fade-up ${accents[i].delay} overflow-hidden border-l-4 ${accents[i].border}`}>
          <span class={`big-numeral ${accents[i].numeral}`}>0{i + 1}</span>

          <div class="relative z-10">
            <p class={`text-xs uppercase tracking-wider ${accents[i].kicker} font-semibold mb-3`}>
              {p.kicker}
            </p>
            <h3 class="text-xl font-semibold text-charcoal mb-4 leading-snug">
              {p.quote}
            </h3>
            <p class="text-charcoal/70 leading-relaxed text-sm">
              {p.body}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Dolny akcent -->
    <p class="mt-12 text-center text-sm text-charcoal/50 italic fade-in delay-400">
      {content.footnote}
    </p>
  </div>
</section>
