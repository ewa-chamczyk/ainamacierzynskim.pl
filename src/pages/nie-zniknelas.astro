---
// Landing page „Nie zniknęłaś" — dedykowany ebookowi
// URL: /nie-zniknelas
// CTA wszędzie → EasyCart: https://easl.ink/Z22wp
import Layout from '../layouts/Layout.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Footer from '../components/Footer.astro';

// EasyCart URL
const EASYCART_URL = 'https://easl.ink/Z22wp';

// 7 listów + krótki kontekst pod pull quote
const letters = [
  { n: '01', title: 'Nie zniknęłaś', quote: 'Pomyśl o tym jak o pokoju w Twoim domu, który zamknęłaś na czas remontu. Meble stoją pod prześcieradłami. Kurz osiada. Ale pokój nadal istnieje', context: 'O tożsamości, która nie umiera w dniu porodu – tylko zostaje przykryta.' },
  { n: '02', title: 'Strach kłamie', quote: 'Strach to emocja, nie fakt', context: 'O lęku przed powrotem i o tym, jak nauczyć się go słyszeć, nie słuchać.' },
  { n: '03', title: 'Nie jesteś gorszym pracownikiem', quote: 'Nie jesteś gorsza. Jesteś inna. Inna nie znaczy mniej – znaczy: szybciej, celniej, z mniejszą liczbą zbędnych ruchów', context: 'O nowych umiejętnościach, których nie miałaś przed dzieckiem.' },
  { n: '04', title: 'Na swoich warunkach', quote: 'Stawianie warunków to nie słabość. To siła', context: 'O różnicy między roszczeniowością a dorosłą decyzją.' },
  { n: '05', title: 'Twoje dziecko nie zabrało Ci kariery', quote: 'Twoja kariera nie umarła. Zmieniła kształt', context: 'O zarządzaniu zmianą, której nie da się cofnąć.' },
  { n: '06', title: 'Rola to nie Ty', quote: 'Gdzieś pod tymi wszystkimi etykietami jest kobieta. Z własnymi pragnieniami, marzeniami, potrzebami. Znajdź ją. Ma na Ciebie ochotę', context: 'O kobiecie pod etykietami „mama", „managerka", „żona".' },
  { n: '07', title: 'Pozwolenie', quote: 'Nie jesteś sama. Jest nas więcej. I każda z nas robi to po swojemu. To jest jedyny sposób, żeby zrobić to dobrze', context: 'O tym, że żadna z nas nie jest sama – i że to jedyny sposób, żeby zrobić to dobrze.' },
];

// 3 persony (z briefu copywriterskiego)
const personas = [
  {
    name: 'Ania, 34',
    role: 'Head of Marketing',
    desc: 'Wróciła po roku urlopu. Czuje, że zespół ją „przerósł". Zostaje po godzinach, żeby udowodnić, że nadal ogarnia.',
  },
  {
    name: 'Kasia, 38',
    role: 'Właścicielka firmy',
    desc: 'Biznes prowadzi od 8 lat. Po dziecku nie da się pracować 12 godzin dziennie. Szuka sposobu, jak okroić obowiązki bez poczucia porażki.',
  },
  {
    name: 'Marta, 32',
    role: 'Specjalistka IT',
    desc: 'Na macierzyńskim, za 3 miesiące wraca. Boi się, że technologia ją wyprzedziła. Chce wrócić, ale nie wie, czy jeszcze „pasuje".',
  },
];

// Czego tu NIE znajdziesz (z briefu)
const niePisze = [
  'Kolejnego poradnika „jak być lepszą mamą"',
  'Influencerskiego bełkotu o work-life balance',
  'Ideologii – ani „musisz wrócić", ani „musisz zostać"',
  'Listy produktywnościowych hacków',
  '„Wstań o 5:00 i medytuj", „wystarczy chcieć", „follow your passion"',
];

// Co tu znajdziesz (z briefu — przeformułowane jako „głos który mówi")
const tuJest = [
  'Głos, który mówi: „Widzę Cię. Rozumiem. Nie jesteś zepsuta."',
  'Pozwolenie, żeby być ambitną mamą bez poczucia winy',
  'Walidacja: „To, co czujesz, nie jest fanaberią. Nie jesteś sama."',
  'Macierzyństwo traktowane jak projekt do zarządzania, nie misja do poświęcenia',
];

// Testimoniale (te same co na home)
const testimonials = [
  {
    text: 'Wreszcie ktoś powiedział głośno, że nie muszę być wdzięczna za to, że pozwolą mi wrócić. To nie jest poradnik. To jest tarcza',
    author: 'Katarzyna',
    role: 'wraca do pracy za 6 tygodni',
    effect: null,
  },
  {
    text: 'Przeczytałam między karmieniami. Trzy dni później wynegocjowałam zdalny piątek z szefem',
    author: 'Monika',
    role: 'kierowniczka projektów, mama Heleny',
    effect: 'Zdalny piątek od poniedziałku po lekturze',
  },
  {
    text: 'Po liście 4 napisałam mailem warunki powrotu. Bez przepraszania, bez trzech akapitów o tym, jak mi zależy. Pierwszy raz w życiu',
    author: 'Aneta',
    role: 'founderka, mama Jasia',
    effect: 'Pierwszy mail bez przepraszania',
  },
];

// FAQ
const faqs = [
  {
    q: 'Czy to jest dla mnie, jeśli jeszcze planuję dziecko?',
    a: 'Tak, jeśli kiedyś będziesz wracać do pracy. Albo jeśli już teraz boisz się tego pytania – co wtedy z karierą? Ten ebook nie jest tylko o samym powrocie. Jest o tożsamości, która zostaje po drodze.',
  },
  {
    q: 'Czy to jest poradnik?',
    a: 'Nie. To listy. Nie powiem Ci, jak być lepszą mamą. Nie dam Ci listy produktywnościowych hacków. Powiem Ci, że masz prawo być sobą.',
  },
  {
    q: 'Czy ebook jest o AI?',
    a: 'Nie. Pracuję z AI od trzech lat – ale ten ebook jest o czymś innym. O powrocie do pracy. O tożsamości. O strachu, który kłamie. AI to inny rozdział mojego życia. Tutaj jestem po prostu Ewą, mamą, kobietą, która wraca.',
  },
  {
    q: 'Czy mogę przeczytać na telefonie?',
    a: 'Tak. PDF czyta się wszędzie – na telefonie, tablecie, laptopie. Format jest projektowany pod ekran, nie pod druk.',
  },
  {
    q: 'Czy mogę zwrócić ebooka?',
    a: 'Nie. Pliku cyfrowego nie da się oddać – jak ktoś go pobrał, to już go ma. Dlatego cały wstęp masz na tej stronie. Przeczytaj zanim kupisz – żebyś wiedziała, w co wchodzisz. Jeśli ton Ci nie pasuje, nie kupuj. To uczciwa umowa.',
  },
  {
    q: 'Kiedy dokładnie dostanę plik?',
    a: 'Od razu po opłaceniu – plik PDF dostajesz linkiem na maila. Sprawdź folder „Oferty" i „Spam", gdyby maila brakowało.',
  },
  {
    q: 'Co z audiobookiem?',
    a: 'Nagrywam wersję audio – czytam Ci listy własnym głosem. Nie podaję jeszcze daty, ale dam znać w newsletterze „AI na macierzyńskim". Jeśli chcesz dostać informację jako pierwsza – zapisz się.',
  },
];

// Wstęp ebooka — CAŁY tekst „Zanim przeczytasz te listy"
const wstepBlocks = [
  { type: 'p', text: 'Niedawno urodziłam córkę.' },
  { type: 'p', text: 'Nikt mnie nie uprzedził, że pierwsze tygodnie będą przypominać onboarding do pracy, w której nie ma opisu stanowiska, przerwy na lunch ani weekendów. Kursy, szkoła rodzenia, wszystkie książki – przygotowały mnie mniej więcej tak, jak prezentacja PowerPoint przygotowuje do prawdziwego projektu. Czyli teoretycznie.' },
  { type: 'p', text: 'Poród nie poszedł zgodnie z planem. Czułam, że zawiodłam. Przede wszystkim siebie. Bo oczywiście – nawet rodzenie dziecka potraktowałam jak KPI do zrealizowania.' },
  { type: 'p', text: 'Dni mijały. Szukałam czegoś – treści, głosu, słów – które trafiłyby do mnie. Do nowej mamy, ale takiej, która całe życie budowała tożsamość daleko poza macierzyństwem. Która przyzwyczaiła się do sprawczości, do decyzyjności, do myślenia strategicznego. I nagle stała w kuchni o trzeciej w nocy, kołysząc dziecko, zastanawiając się, kim teraz jest.' },
  { type: 'p', text: 'Instagramowy feed mnie zawiódł. Pełno w nim było poradników, młodych mam wracających do formy w tempie, które naruszało prawa fizyki. Fizjoterapeutów pokazujących nowe sposoby trzymania, przewijania, podnoszenia. Nawet wkładania dziecka w ręcznik po kąpieli – bo najwyraźniej robiłam to źle przez całe swoje dorosłe życie. Ginęłam w tym. Nie było tam przestrzeni dla kobiety aktywnej intelektualnie. Dla liderki. Dla kogoś, kto potrzebuje myśleć – nie tylko opiekować się.' },
  { type: 'p', text: 'Odinstalowałam Instagram. Pomyślałam: jestem tym, co konsumuję. Nie chcę tak.' },
  { type: 'p', text: 'I wtedy zrodził się pomysł. Napisać to, co sama chciałabym usłyszeć w tamtych dniach. Słowa, których szukałam między jednym karmieniem a drugim – i nie znajdowałam.' },
  { type: 'p', text: 'Kilkanaście dni po porodzie dostałam telefon z pracy. Pytanie brzmiało: kiedy wracasz? Najwyraźniej moje „out of office" nie robiło na nikim wystarczającego wrażenia. Byłam zbita z tropu – nie tak się umawialiśmy. I wtedy poczułam to, co pewnie czeka każdą z nas: moment powrotu. Albo moment decyzji, że nie wracamy – przynajmniej nie w ten sam sposób.' },
  { type: 'p', text: 'Chcę to zrobić w zgodzie z sobą. Bez poczucia winy, że stawiam warunki. Że zostawiam dziecko. Że deleguję. Że chcę pracować. Albo że potrzebuję więcej czasu. Bez przepraszania za to, że mam oczekiwania – bo od kiedy to jest coś, za co trzeba przepraszać?' },
  { type: 'pullquote', text: 'Nie jestem gorsza. Jestem sobą. Tylko trochę bardziej niewyspana.' },
  { type: 'h', text: 'Te listy są dla Ciebie.' },
  { type: 'p', text: 'Dla Ciebie – liderki, managerki, specjalistki, przedsiębiorczyni. Dla Ciebie, która przed dzieckiem wiedziała dokładnie, kim jest. I teraz czuje, że gdzieś po drodze to się rozmyło.' },
  { type: 'p', text: 'Dla Ciebie, która nie szuka porad o nawilżaczach i rozszerzaniu diety. Która szuka czegoś głębszego: pozwolenia, żeby być sobą. Żeby chcieć kariery i nie czuć się z tym źle. Żeby wrócić do pracy – albo nie wrócić – na własnych zasadach.' },
  { type: 'p', text: 'Nie powiem Ci, jak być lepszą mamą. Nie dam Ci listy produktywnościowych hacków. Nie będę udawać, że mam wszystkie odpowiedzi – ledwo ogarniam własne.' },
  { type: 'p', text: 'Chcę tylko, żebyś wiedziała: nie jesteś sama. Jest nas więcej. Jesteś rozumiana.' },
  { type: 'p', text: 'Nie jesteś gorszą mamą, bo chcesz pracować. Nie jesteś gorszą mamą, bo potrzebujesz przestrzeni. Nie jesteś gorszą mamą, bo stawiasz warunki. Każda z tych opcji jest dobra – jeśli jest Twoja.' },
  { type: 'p', text: 'Przeczytaj jeden list dziennie. Albo wszystkie naraz. Twój wybór. I tak nie śpisz.' },
  { type: 'signature', text: 'Ewa' },
];
---

<Layout
  title='„Nie zniknęłaś" – 7 listów do mamy, która chce iść dalej · ebook'
  description="Ebook dla menedżerek i specjalistek wracających do pracy po macierzyńskim. 7 emocjonalnych listów. 48 zł, plik PDF od razu po zakupie."
  ogImage="/images/og-nie-zniknelas.jpg"
>
  <ScrollProgress />

  <!-- ════════════════════════════════════════════════ -->
  <!-- 1. HERO -->
  <!-- ════════════════════════════════════════════════ -->
  <section class="relative px-6 pt-20 pb-24 bg-cream-warm overflow-hidden">
    <!-- Dekoracja -->
    <div class="blob bg-bordo-soft" style="width: 600px; height: 600px; top: -200px; right: -150px; opacity: 0.4;"></div>
    <div class="blob bg-taupe" style="width: 400px; height: 400px; bottom: -100px; left: -100px; opacity: 0.15;"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Lewa kolumna – tekst -->
        <div class="lg:col-span-7 fade-up">
          <p class="text-sm uppercase tracking-widest text-bordo font-medium mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-gold"></span>
            Ebook · 7 listów
          </p>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold text-charcoal mb-6 leading-[1.05]">
            Nie zniknęłaś.
          </h1>

          <p class="text-2xl md:text-3xl text-charcoal/70 font-medium mb-8 leading-snug">
            7 listów do mamy, <br class="hidden md:block" />
            która chce iść dalej.
          </p>

          <p class="text-lg md:text-xl text-charcoal/75 mb-10 leading-relaxed max-w-xl">
            Nie musisz wracać do „dawnej siebie". Możesz iść dalej.
            <strong class="text-charcoal">Na własnych zasadach.</strong>
          </p>

          <!-- CTA -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a
              href={EASYCART_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-bordo hover:bg-bordo-dark text-white font-semibold rounded-xl transition-all hover:scale-105 hover:shadow-xl hover:shadow-bordo/30 group"
            >
              <span>Kup ebooka · 48 zł</span>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="#wstep"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-charcoal border border-sand/60 hover:border-bordo hover:text-bordo font-medium rounded-xl transition-all"
            >
              Przeczytaj wstęp
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>

          <!-- Info o dostawie pod CTA (cena tylko na przycisku) -->
          <p class="text-sm text-charcoal/60">
            Plik PDF od razu po zakupie.
          </p>
        </div>

        <!-- Prawa kolumna – okładka -->
        <div class="lg:col-span-5 fade-up delay-200">
          <div class="relative max-w-md mx-auto">
            <!-- Cień / glow -->
            <div class="absolute -inset-4 bg-gradient-to-br from-bordo/30 to-anthracite/20 rounded-3xl rotate-2"></div>
            <div class="absolute -inset-2 bg-bordo/15 rounded-3xl -rotate-1"></div>

            <img
              src="/images/ebook-cover.png"
              alt="„Nie zniknęłaś" – okładka ebooka"
              class="relative w-full rounded-2xl shadow-2xl"
            />

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════ -->
  <!-- 2. DLA KOGO -->
  <!-- ════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 bg-beige-warm/30 overflow-hidden">
    <div class="blob bg-bordo-soft" style="width: 350px; height: 350px; top: 10%; right: -50px; opacity: 0.25;"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="mb-16 max-w-3xl fade-up">
        <p class="text-sm uppercase tracking-widest text-bordo font-medium mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-gold"></span>
          Dla kogo to jest
        </p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-charcoal leading-tight">
          Trzy kobiety. <br />
          <span class="text-bordo">Każda na innym etapie.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {personas.map((p, idx) => (
          <article class={`bg-white rounded-2xl p-7 card-lift fade-up delay-${idx * 100} border border-sand/30`}>
            <p class="text-xs uppercase tracking-widest text-bordo font-semibold mb-3">
              {p.role}
            </p>
            <h3 class="text-xl font-semibold text-charcoal mb-4">
              {p.name}
            </h3>
            <p class="text-charcoal/75 leading-relaxed text-sm">
              {p.desc}
            </p>
          </article>
        ))}
      </div>

      <p class="mt-10 text-center text-charcoal/60 text-base fade-up delay-300 max-w-2xl mx-auto">
        Jeśli rozpoznajesz siebie w jednej z nich – te listy są dla Ciebie.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════ -->
  <!-- 3. CZEGO TU NIE ZNAJDZIESZ -->
  <!-- ════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 overflow-hidden">
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">
        <!-- Czego NIE znajdziesz -->
        <div class="fade-up">
          <p class="text-sm uppercase tracking-widest text-charcoal/50 font-semibold mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-charcoal/40"></span>
            Czego tu NIE znajdziesz
          </p>
          <h2 class="text-3xl md:text-4xl font-semibold text-charcoal mb-8 leading-tight">
            Bo to nie ta książka.
          </h2>
          <ul class="space-y-4">
            {niePisze.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-charcoal/30 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <p class="text-charcoal/75 leading-relaxed">
                  {item}
                </p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Co znajdziesz -->
        <div class="fade-up delay-200">
          <p class="text-sm uppercase tracking-widest text-bordo font-semibold mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-gold"></span>
            Czym to jest
          </p>
          <h2 class="text-3xl md:text-4xl font-semibold text-charcoal mb-8 leading-tight">
            Głos, którego sama szukałam.
          </h2>
          <ul class="space-y-4">
            {tuJest.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-bordo flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <p class="text-charcoal/85 leading-relaxed">
                  {item}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════ -->
  <!-- 4. DLACZEGO NAPISAŁAM (skrócona historia) -->
  <!-- ════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 bg-beige-warm/30 overflow-hidden">
    <div class="blob bg-moss" style="width: 300px; height: 300px; bottom: -50px; right: 5%; opacity: 0.15;"></div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <!-- Zdjęcie -->
        <div class="md:col-span-5 fade-up">
          <div class="relative max-w-sm mx-auto md:mx-0">
            <div class="absolute -inset-3 bg-bordo/15 rounded-3xl rotate-2"></div>
            <img
              src="/images/ewa-osobiste-2663-web.jpg"
              alt="Ewa Chamczyk – autorka"
              class="relative w-full rounded-2xl shadow-xl object-cover aspect-[3/4]"
            />
          </div>
        </div>

        <!-- Tekst -->
        <div class="md:col-span-7 fade-up delay-200">
          <p class="text-sm uppercase tracking-widest text-bordo font-medium mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-gold"></span>
            Dlaczego to napisałam
          </p>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-charcoal mb-6 leading-tight">
            Pisałam to, czego sama <br />
            szukałam i <span class="text-bordo">nie znajdowałam</span>.
          </h2>
          <div class="space-y-4 text-charcoal/80 leading-relaxed text-base md:text-lg">
            <p>
              Niedawno urodziłam córkę. Szukałam czegoś – treści, głosu, słów – które trafiłyby do mnie.
              Do nowej mamy, ale takiej, która całe życie budowała tożsamość daleko poza macierzyństwem.
            </p>
            <p>
              Nie znalazłam. Instagramowy feed był pełen poradników o tym, jak wkładać dziecko w ręcznik po kąpieli.
              Nie było tam przestrzeni dla kobiety aktywnej intelektualnie. Dla liderki.
              Dla kogoś, kto potrzebuje myśleć – nie tylko opiekować się.
            </p>
            <p>
              Więc usiadłam i napisałam to, co sama chciałabym usłyszeć w tamtych dniach.
              Między jednym karmieniem a drugim.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════ -->
  <!-- 5. CO ZNAJDZIESZ W ŚRODKU – 7 LISTÓW -->
  <!-- ════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 overflow-hidden">
