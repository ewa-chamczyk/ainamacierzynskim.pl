---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="AI na macierzyńskim — spokojny start z AI przed powrotem do pracy"
  description="Marka edukacyjna dla kobiet w ciąży, na macierzyńskim i wracających do pracy. Małe kroki. Konkretne zastosowania. Zero presji."
>
  <section class="min-h-screen flex items-center justify-center px-6 py-20">
    <div class="max-w-3xl w-full text-center">
      <!-- Hero badge -->
      <p class="text-sm tracking-widest uppercase text-terra mb-8 font-medium">
        AI na macierzyńskim
      </p>

      <!-- Hero headline -->
      <h1 class="text-5xl md:text-7xl text-charcoal mb-6 font-semibold">
        Spokojny start z AI <br />
        <span class="text-terra">przed powrotem do pracy.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-xl md:text-2xl text-charcoal/70 mb-12 max-w-2xl mx-auto">
        Małe kroki. Konkretne zastosowania. Zero presji.
      </p>

      <!-- Placeholder dla formularza MailerLite -->
      <div class="max-w-md mx-auto bg-beige/60 border border-beige-dark rounded-2xl p-8">
        <p class="text-charcoal/70 mb-4 text-sm">
          Wkrótce: zapis do newslettera + ebook „Nie zniknęłaś"<br />
          jako prezent na start.
        </p>
        <p class="text-xs text-charcoal/50">
          Premiera: 26 maja 2026
        </p>
      </div>

      <!-- Signature -->
      <p class="mt-16 text-sm text-charcoal/50">
        Projekt Ewy Chamczyk · Trzy lata w AI, wciąż na macierzyńskim
      </p>
    </div>
  </section>
</Layout>
