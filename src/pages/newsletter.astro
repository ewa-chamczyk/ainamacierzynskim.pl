---
// Landing page zapisu na newsletter „AI na macierzyńskim" – URL: /newsletter
// JEDNO zadanie: zapis (imię + e-mail) na newsletter. Zero freebie, zero menu, zero linków wychodzących.
// Tło: bordo z gradientem + miękkie poświaty brzoskwiniowe (decyzja Ewy 03.08.2026).
//
// MailerLite (konto 2290800): formularz „Newsletter AI na macierzyńskim (landing /newsletter)"
// ID 194764420703847967, pola imię + e-mail.
// Zapis trafia do DWÓCH grup naraz:
//   · ai-na-macierzynskim-newsletter (187343853788857528)
//   · welcome-nurture               (192276891856536605) → odpala automation „ANM Nurture po magnesie"
// SINGLE opt-in (bez potwierdzenia) – copy podziękowania napisane pod ten wariant.

const title = 'Newsletter AI na macierzyńskim – jedna lekcja tygodniowo';
const description =
  'Co czwartek wieczorem: jedna lekcja o AI, jeden gotowy prompt i jedno zastosowanie w Twojej pracy. Dla mam wracających do pracy. Bez żargonu, za darmo.';
const canonical = 'https://ainamacierzynskim.pl/newsletter';
const ogImage = 'https://ainamacierzynskim.pl/images/og-home.jpg';

// Endpoint zapisu MailerLite – formularz newsletterowy (obie grupy: newsletter + nurture).
const ML_ENDPOINT =
  'https://assets.mailerlite.com/jsonp/2290800/forms/194764420703847967/subscribe';

// Zgoda pod formularzem – wersja newsletterowa (bez freebie, w odróżnieniu od /mapa i /plan).
const CONSENT =
  'Zapisując się, dostajesz mój newsletter „AI&nbsp;na&nbsp;macierzyńskim" – 1&nbsp;lekcja + 1&nbsp;prompt tygodniowo – oraz zgadzasz się na otrzymywanie ode mnie e-maili marketingowych (newsletter i&nbsp;informacje o&nbsp;moich produktach). Bez spamu, wypiszesz się jednym kliknięciem. <a href="/polityka-prywatnosci">Polityka prywatności</a> · <a href="/regulamin">Regulamin</a>';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="AI na macierzyńskim" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800;900&family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      :root {
        --bordo: #6b1f1f;
        --bordo-hi: #7d2828;
        --wino: #4a1721;
        --wino-2: #3c121b;
        --krem: #f2e9dd;
        --krem-dim: rgba(242, 233, 221, 0.74);
        --peach: #eea679;
        --peach-deep: #d88458;
        --error: #f3b3a0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      /* atrybut hidden musi wygrać z .form{display:flex} i innymi regułami display */
      [hidden] { display: none !important; }
      html { scroll-behavior: smooth; }
      body {
        /* gradient bordo → wino, żeby tło nie było płaskie */
        background:
          radial-gradient(900px 520px at 82% -8%, rgba(238, 166, 121, 0.20), transparent 62%),
          radial-gradient(760px 480px at -10% 34%, rgba(216, 132, 88, 0.14), transparent 60%),
          radial-gradient(700px 600px at 60% 108%, rgba(238, 166, 121, 0.12), transparent 62%),
          linear-gradient(168deg, var(--bordo-hi) 0%, var(--bordo) 40%, var(--wino) 100%);
        background-attachment: fixed;
        color: var(--krem);
        font-family: 'Archivo', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        min-height: 100vh;
      }
      .wrap { max-width: 820px; margin: 0 auto; padding: 0 28px; position: relative; z-index: 2; }
      .label {
        font-family: 'IBM Plex Mono', monospace; font-weight: 500;
        font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--peach);
        display: inline-flex; align-items: center; gap: 12px;
      }
      .label::before { content: ''; display: block; width: 30px; height: 1px; background: var(--peach); }
      .ghost {
        position: absolute; right: -5vw; top: -5vh;
        font-family: 'Fraunces', serif; font-style: italic; font-weight: 600;
        font-size: 56vw; line-height: 0.7; color: var(--krem); opacity: 0.05;
        pointer-events: none; z-index: 1; user-select: none;
      }

      /* HERO */
      .hero { padding: 62px 0 52px; position: relative; }
      h1 {
        font-family: 'Archivo', sans-serif; font-weight: 900;
        font-size: clamp(38px, 7.4vw, 64px); line-height: 1.03; letter-spacing: -0.03em;
        margin: 18px 0 18px;
      }
      h1 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .sub { font-size: clamp(17px, 2.6vw, 20px); color: var(--krem-dim); max-width: 560px; }

      /* FORM */
      .form { margin: 30px 0 12px; display: flex; flex-wrap: wrap; gap: 10px; max-width: 620px; }
      .form .field {
        flex: 1 1 180px; min-width: 0;
        background: var(--krem); color: var(--wino);
        border: 2px solid transparent; border-radius: 10px; padding: 16px 18px;
        font-family: 'Archivo', sans-serif; font-size: 16px; font-weight: 500;
      }
      .form .field::placeholder { color: rgba(74, 23, 33, 0.55); }
      .form .field:focus-visible { outline: none; border-color: var(--peach); }
      .form button {
        flex: 0 0 auto;
        background: var(--peach); color: var(--wino-2);
        border: none; border-radius: 10px; padding: 16px 28px;
        font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 16px;
        cursor: pointer; transition: transform 0.12s ease, background 0.12s ease;
      }
      .form button:hover { transform: translateY(-2px); background: var(--peach-deep); }
      .form button:disabled { opacity: 0.65; cursor: progress; transform: none; }
      /* honeypot — niewidoczny dla ludzi, łapie boty */
      .hp { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

      .micro { font-size: 13.5px; color: var(--krem-dim); max-width: 560px; }
      .micro a { color: var(--peach); }
      .form-status { margin: 4px 0 12px; font-size: 14.5px; font-weight: 600; color: var(--error); max-width: 560px; }

      /* THANK YOU */
      .thankyou {
        margin: 30px 0 12px; max-width: 560px;
        border: 1px solid rgba(238, 166, 121, 0.45); border-radius: 14px;
        padding: 22px 24px; background: rgba(238, 166, 121, 0.10);
      }
      .thankyou:focus-visible { outline: 2px solid var(--peach); outline-offset: 3px; }
      .thankyou-h { font-size: 20px; font-weight: 800; margin-bottom: 8px; }
      .thankyou-h em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .thankyou p:last-child { color: var(--krem-dim); font-size: 16px; }

      /* SECTIONS */
      section { padding: 46px 0; border-top: 1px solid rgba(242, 233, 221, 0.14); }
      h2 {
        font-family: 'Archivo', sans-serif; font-weight: 800;
        font-size: clamp(24px, 4.2vw, 32px); letter-spacing: -0.02em; margin-bottom: 22px;
      }
      h2 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--peach); }
      .lead-2 { color: var(--krem-dim); font-size: 17px; max-width: 560px; margin: -10px 0 26px; }
      ul { list-style: none; display: grid; gap: 15px; }
      li { position: relative; padding-left: 30px; font-size: 17px; color: var(--krem); }
      li::before { content: '→'; position: absolute; left: 0; top: 0; color: var(--peach); font-weight: 800; }
      li strong { font-weight: 800; }

      /* PODGLĄD WYDAŃ – miniatury prawdziwych newsletterów */
      .peek { display: flex; gap: 20px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
      .peek figure {
        width: min(46%, 260px);
        background: var(--krem); border-radius: 14px; padding: 9px;
        box-shadow: 0 24px 50px rgba(35, 10, 15, 0.45);
        animation: floatSoft 7s ease-in-out infinite;
      }
      .peek figure:nth-child(1) { transform: rotate(-2deg); }
      .peek figure:nth-child(2) { transform: rotate(2deg); animation-delay: -3.5s; }
      .peek .shot {
        border-radius: 8px; overflow: hidden; background: var(--wino);
        /* pokazujemy górę wydania, resztę przycinamy – to ma być miniatura, nie całe wydanie */
        max-height: 300px;
      }
      /* height:auto jest konieczne – bez niego atrybut height="1860" wymusza wysokość i ściska obraz */
      .peek img { width: 100%; height: auto; display: block; }
      .peek figcaption {
        font-family: 'IBM Plex Mono', monospace; font-weight: 500;
        font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--wino); text-align: center; padding: 10px 4px 4px;
      }
      @keyframes floatSoft {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -9px; }
      }

      /* BIO */
      .bio { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
      .bio .avatar {
        width: 84px; height: 84px; border-radius: 50%; flex: 0 0 auto;
        background: linear-gradient(135deg, var(--peach), var(--peach-deep));
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif; font-style: italic; font-weight: 600;
        font-size: 34px; color: var(--wino-2);
      }
      .bio p { font-size: 17px; color: var(--krem-dim); max-width: 540px; }
      .bio strong { color: var(--krem); font-weight: 800; }

      /* CLOSER */
      .closer h2 { margin-bottom: 24px; }

      footer { padding: 40px 0 56px; text-align: center; }
      .handle { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 13px; letter-spacing: 0.08em; color: var(--krem-dim); }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .form button { transition: none; }
        .peek figure { animation: none; }
      }
    </style>
  </head>
  <body>
    <div class="ghost" aria-hidden="true">N</div>

    <header class="hero">
      <div class="wrap">
        <span class="label">Newsletter · AI na macierzyńskim</span>
        <h1>Jedna lekcja AI tygodniowo. <em>Tyle</em>, ile zmieści się w&nbsp;drzemce.</h1>
        <p class="sub">
          Co czwartek wieczorem dostajesz jedną lekcję, jeden gotowy prompt i&nbsp;jedno zastosowanie
          w&nbsp;Twojej pracy. Bez żargonu i&nbsp;bez poczucia, że masz nadrobić wszystko naraz.
        </p>

        <div class="cta">
          <form class="form" data-ml-form method="POST" action={ML_ENDPOINT} target="_blank">
            <label class="hp" aria-hidden="true">Nie wypełniaj tego pola<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
            <input type="text" name="fields[name]" required autocomplete="given-name" placeholder="Imię" aria-label="Twoje imię" class="field" />
            <input type="email" name="fields[email]" required autocomplete="email" placeholder="Twój e-mail" aria-label="Twój adres e-mail" class="field" />
            <input type="hidden" name="anticsrf" value="true" />
            <input type="hidden" name="ml-submit" value="1" />
            <button type="submit">Zapisz się</button>
          </form>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
          <p class="micro" set:html={CONSENT}></p>
          <div class="thankyou" hidden tabindex="-1">
            <p class="thankyou-h"><em>Jesteś na liście.</em></p>
            <p>Pierwsza wiadomość leci do&nbsp;Ciebie – sprawdź skrzynkę, zajrzyj też w&nbsp;spam i&nbsp;zakładkę „Oferty". Kolejne przychodzą w&nbsp;czwartki wieczorem.</p>
          </div>
        </div>
      </div>
    </header>

    <section>
      <div class="wrap">
        <h2>Co <em>otrzymasz</em> co tydzień</h2>
        <ul>
          <li><strong>Jedną lekcję</strong>, którą zrozumiesz bez technicznego wstępu – jedno pojęcie albo jedna umiejętność naraz</li>
          <li><strong>Jeden prompt</strong> gotowy do skopiowania, z&nbsp;nawiasami do podmiany na Twoje dane</li>
          <li><strong>Jedno zastosowanie</strong> z&nbsp;prawdziwej pracy – mail, spotkanie, raport, rekrutacja</li>
          <li><strong>Jedną czerwoną linię</strong> – czego w&nbsp;tym temacie AI zrobić nie powinno</li>
          <li>Wszystko w&nbsp;czwartek wieczorem, krótko. Do przeczytania, kiedy dom już cichnie.</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Tak to <em>wygląda</em></h2>
        <p class="lead-2">Dwa ostatnie wydania – żeby nie zapisywać się w&nbsp;ciemno.</p>
        <div class="peek">
          <figure>
            <div class="shot">
              <img src="/images/newsletter-wydanie-09.png" alt="Newsletter „AI na macierzyńskim", wydanie 9 – Prompt to nie zaklęcie" loading="lazy" width="1320" height="1860" />
            </div>
            <figcaption>Wydanie #9 · Prompt to nie zaklęcie</figcaption>
          </figure>
          <figure>
            <div class="shot">
              <img src="/images/newsletter-wydanie-10.png" alt="Newsletter „AI na macierzyńskim", wydanie 10 – Spotkanie bez zgubionych ustaleń" loading="lazy" width="1320" height="1860" />
            </div>
            <figcaption>Wydanie #10 · Spotkanie bez ustaleń</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap bio">
        <div class="avatar" aria-hidden="true">E</div>
        <p><strong>Ewa Chamczyk.</strong> Mama, PhD, 3&nbsp;lata w&nbsp;AI (NASK, CampusAI, AI&nbsp;Tact). Uczę mamy wracające do pracy ogarniać AI – po&nbsp;ludzku, w&nbsp;Twoim tempie.</p>
      </div>
    </section>

    <section class="closer">
      <div class="wrap">
        <h2>Zacznij od <em>jednej</em> lekcji w&nbsp;tygodniu.</h2>
        <div class="cta">
          <form class="form" data-ml-form method="POST" action={ML_ENDPOINT} target="_blank">
            <label class="hp" aria-hidden="true">Nie wypełniaj tego pola<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
            <input type="text" name="fields[name]" required autocomplete="given-name" placeholder="Imię" aria-label="Twoje imię" class="field" />
            <input type="email" name="fields[email]" required autocomplete="email" placeholder="Twój e-mail" aria-label="Twój adres e-mail" class="field" />
            <input type="hidden" name="anticsrf" value="true" />
            <input type="hidden" name="ml-submit" value="1" />
            <button type="submit">Zapisz się</button>
          </form>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
          <p class="micro" set:html={CONSENT}></p>
          <div class="thankyou" hidden tabindex="-1">
            <p class="thankyou-h"><em>Jesteś na liście.</em></p>
            <p>Pierwsza wiadomość leci do&nbsp;Ciebie – sprawdź skrzynkę, zajrzyj też w&nbsp;spam i&nbsp;zakładkę „Oferty". Kolejne przychodzą w&nbsp;czwartki wieczorem.</p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <span class="handle">@ai.na.macierzynskim</span>
    </footer>

    <script is:inline>
      (function () {
        var ENDPOINT =
          'https://assets.mailerlite.com/jsonp/2290800/forms/194764420703847967/subscribe';
        var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

        function setStatus(el, msg) {
          if (!el) return;
          el.textContent = msg;
          el.hidden = false;
        }
        function clearStatus(el) {
          if (!el) return;
          el.textContent = '';
          el.hidden = true;
        }
        function showThankYou(cta) {
          var form = cta.querySelector('form');
          var micro = cta.querySelector('.micro');
          var status = cta.querySelector('.form-status');
          var ty = cta.querySelector('.thankyou');
          if (form) form.hidden = true;
          if (micro) micro.hidden = true;
          clearStatus(status);
          if (ty) {
            ty.hidden = false;
            try { ty.focus(); } catch (e) {}
          }
        }
        function firstError(data) {
          try {
            var f = data.errors.fields;
            for (var k in f) { if (f[k] && f[k][0]) return f[k][0]; }
          } catch (e) {}
          return '';
        }

        var forms = document.querySelectorAll('form[data-ml-form]');
        Array.prototype.forEach.call(forms, function (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var cta = form.closest('.cta');
            var status = cta.querySelector('.form-status');
            var btn = form.querySelector('button[type="submit"]');
            var emailInput = form.querySelector('input[type="email"]');
            var hp = form.querySelector('input[name="hp_website"]');

            // bot: honeypot wypełniony → udajemy sukces, nic nie wysyłamy
            if (hp && hp.value) { showThankYou(cta); return; }

            var email = (emailInput.value || '').trim();
            if (!EMAIL_RE.test(email)) {
              setStatus(status, 'Podaj poprawny adres e-mail.');
              emailInput.focus();
              return;
            }

            clearStatus(status);
            var original = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Wysyłam…';

            var fd = new FormData(form);
            fd.delete('hp_website');

            fetch(ENDPOINT, {
              method: 'POST',
              body: fd,
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
            })
              .then(function (res) {
                return res.json().catch(function () { return { success: res.ok }; });
              })
              .then(function (data) {
                if (data && data.success) {
                  showThankYou(cta);
                } else {
                  var err = firstError(data);
                  if (/valid email/i.test(err)) err = 'Podaj poprawny adres e-mail.';
                  setStatus(status, err || 'Coś nie zadziałało. Spróbuj jeszcze raz.');
                  btn.disabled = false;
                  btn.textContent = original;
                }
              })
              .catch(function () {
                setStatus(status, 'Brak połączenia. Spróbuj jeszcze raz za chwilę.');
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      })();
    </script>
  </body>
</html>
