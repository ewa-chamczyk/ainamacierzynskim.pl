---
// Strona „Gabinet AI" — konsultacja 1:1 (497 zł, godzina online) · URL: /gabinet-ai
// Na Layout.astro → globalne menu, paleta wino (decyzja Ewy 08.07: zostawiamy menu + wino).
// Copy: 05_Produkty/Gabinet AI/gabinet-ai-landing-copy.md (v1.0). CTA adaptowane na rezerwację Cal.com
// (Ewa wybrała kalendarz na stronie zamiast lejka DM POWRÓT). Cal event `konsultacja-1-1-60-min`.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const CAL_FALLBACK = 'https://cal.com/ainamacierzynskim/konsultacja-1-1-60-min';
const IG_DM = 'https://ig.me/m/ainamacierzynskim';

const znaszTo = [
  'Wracasz za kilka tygodni i wiesz, że na pierwszym spotkaniu ktoś rzuci nazwę narzędzia, a Ty kiwniesz głową, jakbyś wiedziała, o co chodzi.',
  'Próbowałaś używać ChatGPT do podstawowych zadań, ale poznanie bardziej zaawansowanych funkcji odłożyłaś na później. A teraz stresujesz się, że wszyscy pojechali dalej bez Ciebie.',
  'Masz dość szkoleń, które pokazują funkcje, a we wtorek i tak nie wiesz, jak użyć tego na swoim raporcie.',
  'Spędziłaś ostatni rok zajmując się Małym Człowiekiem i boisz się, że dzisiaj z AI korzysta się zupełnie inaczej niż przed Twoim macierzyńskim.',
];

const jakWyglada = [
  {
    n: '01',
    title: 'Zanim się spotkamy',
    desc: 'Wypełniasz krótką ankietę – rola, trzy zadania, które zabierają Ci najwięcej czasu, narzędzia Twojej firmy. Siadam z tym wcześniej i przygotowuję sesję pod Ciebie. Wchodzisz na spotkanie, na którym nie tłumaczę „czym jest prompt" – od pierwszej minuty jesteśmy przy Twojej pracy.',
  },
  {
    n: '02',
    title: 'Godzina 1:1',
    desc: 'Pracujemy na Twoim ekranie i na Twoich zadaniach – to Ty wszystko robisz, ja prowadzę i podpowiadam. Po godzinie w historii Twojego czatu zostają gotowe, działające rozmowy z AI, których po prostu używasz dalej.',
  },
  {
    n: '03',
    title: 'Twoja ściąga i biblioteka',
    desc: 'Twój setup, Twoje prompty i Skillsy, zasady bezpieczeństwa i plan dalszego rozwoju. Otrzymujesz ode mnie dokument dostosowany do Twoich potrzeb, żebyś miała wszystko w jednym miejscu.',
  },
  {
    n: '04',
    title: 'Tydzień później',
    desc: 'Wracam do Ciebie z jednym pytaniem: co ruszyło, a co nie. Jeśli któryś prompt nie dowozi – poprawiamy. Żadnego „mam nadzieję, że się podobało". Chcę wiedzieć, że tego używasz.',
  },
];

const coMasz = [
  { title: 'Setup gotowy do pracy', desc: 'Narzędzia dobrane i ustawione pod Twoją rolę.' },
  { title: 'Indywidualny przewodnik pracy z AI', desc: 'Dokument zawierający podsumowanie naszego spotkania, jasne wskazówki, rekomendacje, prompty i Skillsy – dopasowany do Twoich potrzeb.' },
  { title: 'Jasne zasady bezpieczeństwa', desc: 'Co wolno wrzucić do AI w firmie, a czego nie, bez ryzyka wobec NDA.' },
  { title: 'Plan dalszego rozwoju', desc: 'Od czego zacząć w pierwszym tygodniu, po jednym zadaniu dziennie.' },
  { title: 'Tydzień na dopięcie', desc: 'Kontakt po sesji, żeby poprawić to, co nie ruszyło.' },
];

const dlaKogo = [
  'wracasz do pracy po macierzyńskim i czujesz, że świat AI Cię wyprzedził,',
  'masz dość ogólnych szkoleń i chcesz to ustawione pod swoją rolę, nie „dla wszystkich",',
  'wolisz godzinę z kimś, kto wie, niż dziesięć wieczorów ze szkoleniem online.',
];

const faq = [
  {
    q: 'Skąd mam wiedzieć, że rozumiesz moją rolę?',
    a: 'Byłam menedżerką – VP of Product – i prowadziłam zespoły. Wiem, jak wygląda raport dla zarządu, follow-up po spotkaniu i tydzień, w którym wszystko na raz. Pracujemy na Twoich zadaniach, nie na przykładach z internetu.',
  },
  {
    q: '497 zł – a jeśli nie wyjdę z niczym konkretnym?',
    a: 'Wychodzisz z gotowym setupem, swoimi promptami i planem – wszystko powstaje na Twoich realnych zadaniach podczas sesji. Do doby dostajesz to spisane w jednym dokumencie, a po tygodniu wracam sprawdzić, czy działa.',
  },
  {
    q: 'Nie znam się na AI. Czy dam radę?',
    a: 'Nie zaczynamy od zera i nie musisz nic umieć wcześniej. Nie tłumaczę teorii – pokazuję, jak użyć AI do tego, co i tak robisz co tydzień. Spokojnie, po ludzku, bez wstydu.',
  },
  {
    q: 'Mam małe dziecko i mało czasu.',
    a: 'Dlatego to jedna godzina online, do której przygotowuję się za Ciebie. Plan po sesji rozkładam na krótkie kroki – jedno zadanie dziennie, po 15 minut, na prawdziwej pracy.',
  },
  {
    q: 'Czy moja firma pozwala na AI? Co z danymi i NDA?',
    a: 'Ustalamy zasady pod Twoją firmę: co możesz wkleić, co dopiero po anonimizacji, a czego nigdy. Wychodzisz z jasną listą, nie z wykładem o RODO.',
  },
  {
    q: 'Co dzieje się po godzinie?',
    a: 'Dostajesz ściągę do doby i kontakt po tygodniu. A jeśli będziesz chciała iść dalej – jesienią otwieram kurs, który przechodzi przez wszystkie obszary. Bez nacisku.',
  },
];
---

<Layout
  title="Gabinet AI – konsultacja 1:1 z AI dla menedżerki po macierzyńskim | Ewa Chamczyk"
  description="Prywatna godzina 1:1, po której AI jest ustawione pod Twoje zadania. Ze ściągą, biblioteką promptów i tygodniem na dopięcie. 497 zł."
>
  <!-- ============ HERO ============ -->
  <section class="relative px-6 pt-20 pb-24 overflow-hidden">
    <div class="blob bg-terra-soft" style="width: 460px; height: 460px; top: -120px; right: -140px;"></div>
    <div class="blob bg-navy-light" style="width: 360px; height: 360px; bottom: -140px; left: -120px; opacity: 0.22;"></div>

    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <p class="eyebrow mb-6 flex items-center justify-center gap-3" style="color: var(--color-wine);">
        <span class="block w-8 h-px bg-terra"></span>
        Gabinet AI · konsultacja 1:1
        <span class="block w-8 h-px bg-terra"></span>
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl mb-7 leading-[1.05] tracking-tight">
        <span class="font-black">Godzina jeden na&nbsp;jeden,<br />po&nbsp;której</span>
        <em class="font-serif italic font-semibold text-terra"> AI działa pod&nbsp;Twoje zadania</em>.
      </h1>

      <p class="text-lg md:text-xl text-wine/75 leading-relaxed mb-8 max-w-2xl mx-auto">
        Prywatna konsultacja dla menedżerki wracającej po&nbsp;macierzyńskim. Pracujemy na&nbsp;Twoich
        zadaniach – wychodzisz ze&nbsp;ściągą, biblioteką promptów i&nbsp;tygodniem na&nbsp;dopięcie.
      </p>

      <div class="flex justify-center">
        <a
          href="#rezerwacja"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 hover:shadow-2xl hover:shadow-terra/30 group"
        >
          <span>Umów wizytę</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ============ ZNASZ TO? ============ -->
  <section class="relative px-6 py-20 bg-beige/30 overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
      <h2 class="text-3xl md:text-4xl font-semibold text-wine leading-tight mb-10">Znasz to?</h2>
      <ul class="space-y-4">
        {znaszTo.map((item) => (
          <li class="flex items-start gap-4 bg-white rounded-2xl p-6 border border-beige-dark/30">
            <span class="w-2 h-2 rounded-full bg-terra flex-shrink-0 mt-2.5"></span>
            <p class="text-wine/80 leading-relaxed">{item}</p>
          </li>
        ))}
      </ul>
      <p class="text-2xl md:text-3xl font-serif italic text-terra mt-10 leading-snug">
        Gabinet AI to godzina, po&nbsp;której to się kończy.
      </p>
    </div>
  </section>

  <!-- ============ CZYM JEST ============ -->
  <section class="relative px-6 py-24 overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
      <p class="eyebrow mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-terra"></span>
        Czym jest Gabinet AI
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-wine leading-tight mb-6">
        Twoja godzina. Twoja praca.
      </h2>
      <p class="text-xl md:text-2xl text-wine/85 leading-relaxed font-light">
        To nie webinar dla stu osób ani nagranie do&nbsp;odhaczenia – umawiasz się ze&nbsp;mną jeden
        na&nbsp;jeden. Przez godzinę pracujemy tylko na&nbsp;Twoich zadaniach: tym mailu, który piszesz
        40&nbsp;minut, tym raporcie dla zarządu, tym follow-upie po&nbsp;spotkaniu, na&nbsp;który nigdy
        nie&nbsp;ma czasu. Wychodzisz z&nbsp;AI ustawionym pod&nbsp;Twoją pracę i&nbsp;z&nbsp;kimś, kto
        tydzień później sprawdzi, czy to działa.
      </p>
    </div>
  </section>

  <!-- ============ JAK TO WYGLĄDA ============ -->
  <section class="relative px-6 py-24 bg-wine text-cream overflow-hidden">
    <div class="blob bg-terra" style="width: 420px; height: 420px; top: -160px; right: -80px; opacity: 0.28;"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 30px 30px;"></div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="mb-14 max-w-2xl">
        <p class="eyebrow mb-4 flex items-center gap-3" style="color: var(--color-terra-light);">
          <span class="block w-8 h-px bg-terra-light"></span>
          Jak to wygląda
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight">Cztery części, jedna godzina.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-12">
        {jakWyglada.map((step) => (
          <div>
            <p class="font-serif italic text-5xl text-terra-light/70 mb-3">{step.n}</p>
            <h3 class="text-xl font-semibold mb-2">{step.title}</h3>
            <p class="text-cream/75 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CO MASZ PO GABINECIE ============ -->
  <section class="relative px-6 py-24 overflow-hidden">
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="mb-14 max-w-2xl">
        <p class="eyebrow mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-terra"></span>
          Co zyskujesz
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-wine leading-tight">Konkret, nie teoria.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {coMasz.map((el) => (
          <article class="flex items-start gap-4 bg-white rounded-2xl p-6 border border-beige-dark/30 card-lift">
            <svg class="w-6 h-6 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <h3 class="font-semibold text-wine mb-1">{el.title}</h3>
              <p class="text-wine/70 leading-relaxed text-sm">{el.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DLA KOGO ============ -->
  <section class="relative px-6 py-20 bg-beige/30 overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
      <h2 class="text-3xl md:text-4xl font-semibold text-wine leading-tight mb-8">
        Gabinet AI jest dla Ciebie, jeśli
      </h2>
      <ul class="space-y-4">
        {dlaKogo.map((item) => (
          <li class="flex items-start gap-4">
            <svg class="w-6 h-6 text-terra flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <p class="text-lg text-wine/80 leading-relaxed">{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ DLACZEGO JA ============ -->
  <section class="relative px-6 py-24 overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-4">
          <div class="relative max-w-xs mx-auto md:mx-0">
            <div class="absolute -inset-2 bg-terra/15 rounded-3xl rotate-2"></div>
            <img
              src="/images/ewa-grz-8225-web.jpg"
              alt="Ewa Chamczyk"
              class="relative w-full aspect-[4/5] object-cover rounded-2xl shadow-xl"
            />
          </div>
        </div>
        <div class="md:col-span-8">
          <p class="eyebrow mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-terra"></span>
            Dlaczego ja
          </p>
          <h2 class="text-2xl md:text-3xl font-semibold text-wine mb-5 leading-tight">Ewa Chamczyk</h2>
          <p class="text-wine/80 leading-relaxed text-lg">
            Byłam menedżerką – VP of Product, Director of Community Programs i&nbsp;kierowniczką działu.
            Dziś prowadzę własne firmy i&nbsp;tworzę „AI na&nbsp;macierzyńskim". Sama jestem
            na&nbsp;macierzyńskim, więc znam ten moment od&nbsp;środka: i&nbsp;to, jak
            wygląda raport dla zarządu po&nbsp;godzinach, i&nbsp;to, jak nauczyć się czegokolwiek między
            karmieniem a&nbsp;praniem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WIĘCEJ NIŻ KURS ============ -->
  <section class="relative px-6 py-20 overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="bg-wine text-cream rounded-3xl px-8 py-12 md:px-14 md:py-14 relative overflow-hidden">
        <div class="blob bg-terra" style="width: 300px; height: 300px; top: -120px; right: -80px; opacity: 0.3;"></div>
        <p class="eyebrow mb-4" style="color: var(--color-terra-light);">Więcej niż kurs</p>
        <p class="text-xl md:text-2xl leading-relaxed font-light relative z-10">
          Na szkoleniu poznajesz narzędzia. W&nbsp;Gabinecie wychodzisz z&nbsp;AI już ustawionym
          pod&nbsp;swoje zadania – z&nbsp;tygodniem na&nbsp;dopięcie, żeby weszło w&nbsp;nawyk.
          <em class="font-serif italic text-terra-light">Godzina, która oszczędza Ci miesiące błądzenia w&nbsp;pojedynkę.</em>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ REZERWACJA (Cal.com inline) ============ -->
  <section id="rezerwacja" class="relative px-6 py-24 bg-wine text-cream overflow-hidden">
    <div class="blob bg-terra" style="width: 420px; height: 420px; bottom: -160px; right: -100px; opacity: 0.25;"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 30px 30px;"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <p class="eyebrow mb-4 flex items-center justify-center gap-3" style="color: var(--color-terra-light);">
          <span class="block w-8 h-px bg-terra-light"></span>
          Rezerwacja
          <span class="block w-8 h-px bg-terra-light"></span>
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-cream leading-tight mb-5">
          Jak zarezerwować godzinę
        </h2>
        <p class="text-2xl font-semibold text-terra-light mb-4">
          497 zł <span class="text-cream/60 text-lg font-normal">· godzina online (Zoom)</span>
        </p>
        <p class="text-cream/75 leading-relaxed">
          Gabinet otwieram w&nbsp;kameralnych oknach – kilka miejsc w&nbsp;miesiącu, żeby każda dostała
          pełne przygotowanie. Wybierz termin poniżej. Przed sesją dostajesz krótką ankietę – rola, trzy
          zadania, narzędzia Twojej firmy – żebym przygotowała spotkanie pod&nbsp;Ciebie.
        </p>
      </div>

      <!-- Cal inline embed -->
      <div class="bg-white rounded-2xl border border-beige-dark/30 shadow-2xl p-2 md:p-4">
        <div style="width:100%;min-height:640px" id="my-cal-inline-konsultacja-1-1-60-min"></div>
      </div>

      <p class="text-center text-sm text-cream/55 mt-5">
        Kalendarz się nie&nbsp;ładuje?
        <a href={CAL_FALLBACK} target="_blank" rel="noopener" class="text-cream/80 hover:text-terra-light underline underline-offset-2">Otwórz rezerwację w&nbsp;nowym oknie</a>.
        Masz pytanie przed rezerwacją?
        <a href={IG_DM} target="_blank" rel="noopener" class="text-cream/80 hover:text-terra-light underline underline-offset-2">Napisz do&nbsp;mnie</a>.
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="relative px-6 py-24 overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
      <div class="mb-12">
        <p class="eyebrow mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-terra"></span>
          Pytania i obawy
        </p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-wine leading-tight">Zanim się zapiszesz</h2>
      </div>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white rounded-2xl border border-beige-dark/30 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-semibold text-wine">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-terra flex-shrink-0 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="px-6 pb-6 text-wine/75 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DOMKNIĘCIE ============ -->
  <section class="relative px-6 py-24 bg-wine text-cream overflow-hidden">
    <div class="blob bg-terra" style="width: 460px; height: 460px; top: -160px; left: -120px; opacity: 0.28;"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 30px 30px;"></div>

    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-6">
        Godzina teraz zamiast <em class="font-serif italic text-terra-light">miesięcy nadrabiania</em> później.
      </h2>
      <p class="text-cream/75 leading-relaxed text-lg mb-9 max-w-xl mx-auto">
        Kilka miejsc w&nbsp;miesiącu. Jeśli czujesz, że to dla Ciebie – wybierz termin i&nbsp;zaczynamy.
      </p>
      <a
        href="#rezerwacja"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-terra hover:bg-terra-dark text-wine font-semibold rounded-xl transition-all hover:scale-105 group"
      >
        <span>Umów wizytę</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<!-- Cal.com inline embed – kod dostarczony przez Ewę. is:inline = Astro nie bundluje, skrypt wykonuje się w przeglądarce. -->
<script is:inline>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "konsultacja-1-1-60-min", {origin:"https://app.cal.com"});
