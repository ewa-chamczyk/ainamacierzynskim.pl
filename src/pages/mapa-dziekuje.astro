---
// Strona „dziękuję" po zapisie na lead magnet — URL: /mapa-dziekuje
// Cel: pobieranie Mapy 5 obszarów AI (PDF z public/) + nudge na IG.
// Branding spójny z /mapa (wino / terakota / krem). Standalone, poza Layout.astro.
// PDF pod URL: /mapa-5-obszarow.pdf (1.1 MB).

const title = 'Mapa już do Ciebie wraca – AI na macierzyńskim';
const description =
  'Dziękuję. Twoja Mapa 5 obszarów AI jest gotowa do pobrania. PDF też wysłałam mailem.';
const canonical = 'https://ainamacierzynskim.pl/mapa-dziekuje';
const PDF_URL = '/mapa-5-obszarow.pdf';
const IG_URL = 'https://www.instagram.com/ainamacierzynskim/';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;800;900&family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      :root {
        --wino: #4a1721;
        --wino-2: #3c121b;
        --terakota: #D97339;
        --krem: #f2e9dd;
        --krem-dim: rgba(242, 233, 221, 0.72);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--wino);
        color: var(--krem);
        font-family: 'Archivo', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        min-height: 100vh;
      }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 28px; position: relative; z-index: 2; }
      .label {
        font-family: 'IBM Plex Mono', monospace; font-weight: 500;
        font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase;
        color: var(--terakota);
      }
      .ghost {
        position: absolute; right: -4vw; bottom: -6vh;
        font-family: 'Fraunces', serif; font-style: italic; font-weight: 600;
        font-size: 62vw; line-height: 0.7; color: var(--krem); opacity: 0.06;
        pointer-events: none; z-index: 1; user-select: none;
      }

      .hero { padding: 64px 0 40px; position: relative; }
      h1 {
        font-family: 'Archivo', sans-serif; font-weight: 900;
        font-size: clamp(40px, 8vw, 68px); line-height: 1.02; letter-spacing: -0.03em;
        margin: 18px 0 18px;
      }
      h1 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--terakota); }
      .sub { font-size: clamp(17px, 2.6vw, 20px); color: var(--krem-dim); max-width: 560px; }

      .cta-block { margin: 36px 0 8px; display: flex; flex-direction: column; gap: 14px; align-items: center; text-align: center; }
      .cta {
        display: inline-flex; align-items: center; gap: 12px;
        background: var(--terakota); color: var(--wino-2);
        border: none; border-radius: 12px; padding: 20px 30px;
        font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 18px;
        text-decoration: none;
        cursor: pointer; transition: transform 0.12s ease;
      }
      .cta:hover { transform: translateY(-2px); }
      .cta-meta { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; color: var(--krem-dim); letter-spacing: 0.04em; }

      .micro { font-size: 14.5px; color: var(--krem-dim); max-width: 560px; margin: 6px auto 0; text-align: center; }
      .micro a { color: var(--terakota); }

      section { padding: 46px 0; border-top: 1px solid rgba(242, 233, 221, 0.12); }
      h2 {
        font-family: 'Archivo', sans-serif; font-weight: 800;
        font-size: clamp(24px, 4.2vw, 32px); letter-spacing: -0.02em; margin-bottom: 22px;
      }
      h2 em { font-family: 'Fraunces', serif; font-style: italic; font-weight: 600; color: var(--terakota); }
      ul { list-style: none; display: grid; gap: 14px; }
      li { position: relative; padding-left: 30px; font-size: 17px; color: var(--krem); }
      li::before { content: '→'; position: absolute; left: 0; top: 0; color: var(--terakota); font-weight: 800; }
      li a { color: var(--krem); border-bottom: 1px solid rgba(224, 138, 91, 0.55); text-decoration: none; }
      li a:hover { color: var(--terakota); }

      footer { padding: 40px 0 56px; text-align: center; }
      footer a { color: var(--krem-dim); font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.08em; text-decoration: none; }
      footer a:hover { color: var(--terakota); }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .cta { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="ghost" aria-hidden="true">M</div>

    <header class="hero">
      <div class="wrap">
        <span class="label">Mapa 5 obszarów AI</span>
        <h1>Mapa <em>do Ciebie</em> wraca.</h1>
        <p class="sub">
          Dziękuję, że tu jesteś. Pobierz PDF – sześć minut czytania, pięć konkretów, pięć gotowych promptów.
        </p>

        <div class="cta-block">
          <a class="cta" href={PDF_URL} download="mapa-5-obszarow-ai.pdf">
            Pobierz Mapę (PDF)
          </a>
        </div>
      </div>
    </header>

    <footer>
      <a href="/">← ainamacierzynskim.pl</a>
    </footer>
  </body>
</html>
